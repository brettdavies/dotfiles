[Unit]
Description=GBrain incremental sync + embed backfill (all registered sources)
Documentation=file:///home/brett/gbrain/docs/guides/cron-schedule.md
Documentation=file:///home/brett/gbrain/docs/guides/live-sync.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH=/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/brett/dotfiles/scripts/sync/gbrain-sync.sh
StandardOutput=append:%h/.gbrain/sync.log
StandardError=append:%h/.gbrain/sync.err

# Hardening
NoNewPrivileges=true
PrivateTmp=true
