#!/usr/bin/env bash
# agent-slot — hands out full clones of a repo ("slots") on this server, one agent task per slot, and owns every
# check before a slot is torn down. The Rex helper on the Mac, the operator's shell, and agents all call it.
#
# Usage: agent-slot <verb> [options] [--output json]
# Verbs and options: agent-slot --help, and agent-slot <verb> --help.
#
# Env (each defaults to the path in parentheses):
#   AGENT_SLOT_ROOT            slot root (~/slots)
#   AGENT_SLOT_DEV             where prime checkouts live (~/dev)
#   AGENT_SLOT_EXTRA_PRIMES    colon-separated prime checkouts outside it (~/dotfiles)
#   AGENT_SLOT_STATE_DIR       ledger and failure logs (~/.local/state/agent-slot)
#   AGENT_SLOT_RUN_DIR         the status hook's per-pane locks ($XDG_RUNTIME_DIR/agent-slot-<uid>)
#   AGENT_SLOT_CLAUDE_PROJECTS Claude's per-project directories, read only (~/.claude/projects)
#   AGENT_SLOT_MAX_PER_REPO    live slots one repo may hold (8)
#   AGENT_SLOT_LOCK_WAIT       seconds resume waits for a busy slot (30)
#   AGENT_SLOT_TRUST_SOCKET    the trust step's scratch tmux socket (agent-slot-trust)
#   AGENT_SLOT_TRUST_TIMEOUT   seconds the trust step watches Claude's screen (45)
#   AGENT_SLOT_TMUX_SOCKET     slot tmux socket name (agent-slots)
#   AGENT_SLOT_TMUX_CONF       slot tmux config (~/.config/tmux/slots.conf)
#   AGENT_SLOT_SOLUTIONS       shared solutions repo (~/dev/solutions-docs)
#   AGENT_SLOT_GIT_CRYPT_KEY   git-crypt key (~/.config/git-crypt/key)
#   AGENT_SLOT_CLAUDE_STATE    Claude's app-state file, read only (~/.claude.json)
#   AGENT_SLOT_TMUX, _CLAUDE, _GH, _GIT_CRYPT, _TRASH, _JQ, _SYSTEMCTL
#                              absolute paths that replace the binaries found on the pinned PATH

if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4))); then
  for b in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    [ -x "$b" ] && exec "$b" "$0" "$@"
  done
  echo "ERROR: needs bash >= 4.4 (running $BASH_VERSION); install it with: brew install bash" >&2
  exit 1
fi

set -euo pipefail

AS_HOME=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
AS_LIB=$AS_HOME/lib

# shellcheck source=lib/env.sh
source "$AS_LIB/env.sh"
# shellcheck source=lib/contract.sh
source "$AS_LIB/contract.sh"
# shellcheck source=lib/record.sh
source "$AS_LIB/record.sh"
# shellcheck source=lib/bounded.sh
source "$AS_LIB/bounded.sh"
# shellcheck source=lib/agentstate.sh
source "$AS_LIB/agentstate.sh"
# shellcheck source=lib/trust.sh
source "$AS_LIB/trust.sh"
# shellcheck source=lib/read.sh
source "$AS_LIB/read.sh"
# shellcheck source=lib/doctor.sh
source "$AS_LIB/doctor.sh"
# shellcheck source=lib/parity.sh
source "$AS_LIB/parity.sh"
# shellcheck source=lib/sessions.sh
source "$AS_LIB/sessions.sh"
# shellcheck source=lib/launch.sh
source "$AS_LIB/launch.sh"
# shellcheck source=lib/prstate.sh
source "$AS_LIB/prstate.sh"
# shellcheck source=lib/homescan.sh
source "$AS_LIB/homescan.sh"
# shellcheck source=lib/check.sh
source "$AS_LIB/check.sh"

if ! agent_slot_env "$AS_HOME"; then
  echo "agent-slot: dependency-missing: neither jaq nor jq is installed; next: brew install jaq" >&2
  exit "$EXIT_CONFIG"
fi

# Usage: require_tools <tool...>; refuses with dependency-missing naming the first one absent.
require_tools() {
  local tool
  contract_use_tools "$@"
  for tool in "$@"; do
    [[ -n ${AS_TOOL[$tool]:-} ]] && continue
    contract_fail dependency-missing "$tool is not installed on this server" --value "$tool" \
      --command "$(_doctor_install_hint "$tool")"
  done
}

USAGE='usage: agent-slot <verb> [options] [--output json]

Verbs:
  repos    list the prime checkouts a slot can be made from
  list     list every slot with its state, agent, task, and what blocks its teardown
  whoami   print the slot the current directory is inside
  launch   start an agent in a fresh slot of a repo, optionally with its first message
  resume   bring back the tmux sessions and Claude conversation of a slot
  warm     trust the next slot paths of a repo in Claude ahead of time
  check    judge whether each slot can be torn down, and list what blocks it
  doctor   check every launch prerequisite and summarize launch times

Every verb takes --output json (one JSON object on stdout, or an error object on stderr) and --help.
Exit codes: 0 ok, 1 failed, 2 usage, 77 auth, 78 configuration.
Reasons and their fixes: https://github.com/brettdavies/dotfiles/blob/main/README.md#agent-slot-reasons'

VERBS=' repos list whoami launch resume warm check doctor '

verb_help() {
  case $1 in
    repos) printf '%s\n' 'usage: agent-slot repos [--output json]' \
      'Lists each git repo under ~/dev (and ~/dotfiles) that has an origin.' \
      'example: agent-slot repos --output json' ;;
    list) printf '%s\n' 'usage: agent-slot list [--output json]' \
      'Lists every slot with its state, agent state, task, and its needs-you blockers.' \
      "example: agent-slot list --output json | jaq '.slots[] | select(.needs_you != [])'" ;;
    whoami) printf '%s\n' 'usage: agent-slot whoami [--path DIR] [--output json]' \
      'Prints the slot that DIR (default: the current directory) is inside, or not-in-slot.' \
      'example: agent-slot whoami --output json' ;;
    launch) printf '%s\n' \
      'usage: agent-slot launch <repo> [--request-id ID] [--task NAME] [--prompt-file FILE] [--requested-at EPOCH]' \
      '                         [--output json]' \
      'Clones the repo into its lowest free slot, sets it up like the prime checkout, and starts Claude there. A repeat' \
      'with the same --request-id (or --task) returns the same slot. Agents always pass --request-id.' \
      'example: agent-slot launch dotfiles --request-id "$(uuidv7)" --prompt-file brief.md --output json' ;;
    resume) printf '%s\n' 'usage: agent-slot resume <repo>/<N> [--output json]' \
      "Starts whichever of the slot's tmux sessions are missing, resuming its Claude conversation by session ID." \
      'example: agent-slot resume dotfiles/2' ;;
    warm) printf '%s\n' 'usage: agent-slot warm <repo> [--count N] [--output json]' \
      "Trusts slot paths 1 through N (default 3) in Claude, so no launch there spends time on the trust step." \
      'example: agent-slot warm dotfiles --count 4' ;;
    check) printf '%s\n' 'usage: agent-slot check [<repo>/<N>] [--output json]' \
      'Judges each slot (or one): whether its task has finished and what blocks its teardown. It deletes nothing.' \
      'example: agent-slot check dotfiles/2 --output json' ;;
    doctor) printf '%s\n' 'usage: agent-slot doctor [--output json]' \
      'Checks every launch prerequisite on this server and the time from key press to Claude idle.' \
      'example: agent-slot doctor' ;;
  esac
}

usage_fail() {
  local help=agent-slot
  [[ $CONTRACT_VERB == agent-slot ]] || help+=" $CONTRACT_VERB"
  if (($# > 1)); then
    contract_fail usage "$1" --value "$2" --command "$help --help"
  fi
  contract_fail usage "$1" --command "$help --help"
}

main() {
  contract_init agent-slot "$@"
  local verb=${1:-}
  case $verb in
    '' | -h | --help | help)
      CONTRACT_EMITTED=1
      printf '%s\n' "$USAGE"
      return 0
      ;;
    -V | --version)
      CONTRACT_EMITTED=1
      git -C "$AS_HOME" rev-parse --short HEAD 2>/dev/null || echo unknown
      return 0
      ;;
  esac
  shift
  [[ $VERBS == *" $verb "* ]] || {
    CONTRACT_OUTPUT=$([[ " $* " == *" --output json "* ]] && echo json || echo text)
    contract_fail usage "unknown verb: $verb" --value "$verb" --command "agent-slot --help"
  }
  CONTRACT_VERB=$verb

  local args=()
  while (($#)); do
    case $1 in
      -h | --help)
        CONTRACT_EMITTED=1
        verb_help "$verb"
        return 0
        ;;
      --output)
        [[ ${2:-} == json || ${2:-} == text ]] || usage_fail "--output takes json or text" "${2:-}"
        CONTRACT_OUTPUT=$2
        shift
        ;;
      --output=*)
        CONTRACT_OUTPUT=${1#--output=}
        [[ $CONTRACT_OUTPUT == json || $CONTRACT_OUTPUT == text ]] || usage_fail "--output takes json or text" "$1"
        ;;
      *) args+=("$1") ;;
    esac
    shift
  done

  case $verb in
    repos | list | doctor)
      ((${#args[@]} == 0)) || usage_fail "$verb takes no arguments" "${args[0]}"
      exec </dev/null
      [[ $verb != list ]] || require_tools tmux claude
      "cmd_$verb"
      ;;
    whoami)
      if ((${#args[@]} == 2)) && [[ ${args[0]} == --path ]]; then
        WHOAMI_PATH=${args[1]}
      elif ((${#args[@]} != 0)); then
        usage_fail "whoami takes only --path DIR" "${args[0]}"
      fi
      exec </dev/null
      cmd_whoami
      ;;
    launch)
      launch_parse_args "${args[@]}"
      exec </dev/null
      cmd_launch
      ;;
    resume)
      ((${#args[@]} == 1)) || usage_fail "resume takes one slot, <repo>/<N>" "${args[*]}"
      exec </dev/null
      cmd_resume "${args[0]}"
      ;;
    check)
      ((${#args[@]} <= 1)) || usage_fail "check takes at most one slot, <repo>/<N>" "${args[*]}"
      CHECK_KEY=${args[0]:-}
      exec </dev/null
      cmd_check
      ;;
    warm)
      warm_parse_args "${args[@]}"
      exec </dev/null
      cmd_warm "$WARM_REPO" "$WARM_COUNT"
      ;;
  esac
}

main "$@"
