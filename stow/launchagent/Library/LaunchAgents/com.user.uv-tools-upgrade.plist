<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Upgrade of every uv-installed tool (macOS), at most once a day, through
    scripts/upgrade/uv-tools.sh. Counterpart to uv-tools-upgrade.timer on the
    Linux server. The script loads the release cooldown from config/shell and
    refuses to run without it.

    launchd fires the job every hour at half past, half an hour after
    com.user.brew-upgrade's fire, so in the day's first online hour `bu`
    upgrades uv before this job runs. scripts/upgrade/daily-gate.sh lets a fire
    through only when the job has not succeeded in the last 20 hours and the
    network answers.

    RunAtLoad is off so that bootstrapping the agent does not start an upgrade.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.uv-tools-upgrade</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/bin:/bin"; exec "$HOME/dotfiles/scripts/launchd-run.sh" uv-tools-upgrade.jsonl "$HOME/dotfiles/scripts/upgrade/daily-gate.sh" uv-tools-upgrade "$HOME/dotfiles/scripts/upgrade/uv-tools.sh"</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
