#!/usr/bin/env bash
set -euo pipefail

# Stow deployment wrapper with automatic conflict resolution
# Handles: non-stow symlinks, existing plain files, tree folding
#
# This script is intentionally kept as a single file (no sourced helpers)
# to ensure reliable execution on freshly cloned repos across thousands
# of headless servers. See docs/solutions/.../stow-conflict-resolution-wrapper.md
#
# Usage: scripts/stow-deploy [--headless] [--all] [package ...]

# Exit codes — distinct values for automation/CI (all non-zero still indicate failure)
EXIT_USAGE=2        # Bad arguments or flags
EXIT_DEPENDENCY=3   # Missing required tools (stow, git-crypt)
EXIT_PRECONDITION=4 # Pre-flight check failed (dirty stow dir, git-crypt lock)
EXIT_PACKAGE=5      # Package-specific failure (stow error, tree-fold failure)
EXIT_PLATFORM=6     # Platform mismatch (launchagent on Linux)

# Package sets — single source of truth
# Ordering: secrets first (git-crypt dep), shell (PATH/env), then the rest
# Cross-reference: dotfiles-cli has its own PACKAGE_ORDER in src/link/mod.rs
SHARED_PACKAGES=(secrets shell zsh bash git ssh gh local claude codex opencode pip brew)
DESKTOP_PACKAGES=(ghostty cursor launchagent)

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
STOW_DIR="$REPO_ROOT/stow"
TARGET="$HOME"
HEADLESS=false
ALL=false

# Parse flags
while [[ "${1:-}" == --* ]]; do
  case "$1" in
    --headless) HEADLESS=true; shift ;;
    --all) ALL=true; shift ;;
    *) echo "ERROR: Unknown flag: $1" >&2; exit "$EXIT_USAGE" ;;
  esac
done

# Package expansion
if [ "$ALL" = true ]; then
  if [ $# -gt 0 ]; then
    echo "ERROR: --all cannot be combined with explicit package names" >&2
    exit "$EXIT_USAGE"
  fi
  platform=$(uname -s)
  case "$platform" in
    Darwin) set -- "${SHARED_PACKAGES[@]}" "${DESKTOP_PACKAGES[@]}" ;;
    Linux)  set -- "${SHARED_PACKAGES[@]}" ;;
    *)      echo "FATAL: unsupported platform: $platform. Use explicit package names." >&2
            exit "$EXIT_PLATFORM" ;;
  esac
else
  # Extra args extend shared defaults; no args = shared only
  set -- "${SHARED_PACKAGES[@]}" "$@"

  # Deduplicate while preserving order (bash 3.2 compatible — no associative arrays)
  _deduped=()
  for _pkg in "$@"; do
    _dup=false
    for _existing in "${_deduped[@]+"${_deduped[@]}"}"; do
      if [[ "$_pkg" == "$_existing" ]]; then _dup=true; break; fi
    done
    if ! $_dup; then _deduped+=("$_pkg"); fi
  done
  set -- "${_deduped[@]}"
  unset _deduped _pkg _dup _existing
fi

# --- Pre-flight checks ---

# Verify stow is installed
if ! command -v stow >/dev/null 2>&1; then
  echo "FATAL: GNU Stow is not installed" >&2
  exit "$EXIT_DEPENDENCY"
fi

# Warn about known stow 2.3.1 nested dot- bug
stow_version=$(stow --version 2>&1 | sed -n 's/.*version //p')
case "$stow_version" in
  2.3.*|2.2.*|2.1.*|2.0.*)
    echo "WARNING: Stow $stow_version has known --dotfiles bug with nested directories" >&2
    echo "         Packages with nested dot- dirs (git, ssh, gh, pip, claude) may fail" >&2
    ;;
esac

# Validate package names (no path traversal)
for pkg in "$@"; do
  if [[ "$pkg" =~ [./] ]] || [[ ! -d "$STOW_DIR/$pkg" ]]; then
    echo "ERROR: Invalid package name: $pkg" >&2
    exit "$EXIT_USAGE"
  fi
done

# Check git-crypt unlock status for encrypted packages
for pkg in "$@"; do
  case "$pkg" in
    secrets|ssh|git)
      if [ -f "$STOW_DIR/secrets/dot-secrets" ]; then
        # grep -qI treats binary files as non-matching (no `file` command needed)
        if ! grep -qI '' "$STOW_DIR/secrets/dot-secrets" 2>/dev/null; then
          echo "FATAL: git-crypt is locked. Encrypted files would be deployed as binary blobs." >&2
          echo "       Run: git-crypt unlock ~/.config/git-crypt/key" >&2
          exit "$EXIT_PRECONDITION"
        fi
      fi
      break  # only need to check once
      ;;
  esac
done

# Check for dirty stow directory
dirty=$(git -C "$REPO_ROOT" status --porcelain stow/ 2>/dev/null || true)
if [ -n "$dirty" ]; then
  if [ "$HEADLESS" = true ]; then
    echo "FATAL: stow/ has uncommitted changes. In --headless mode, --adopt followed" >&2
    echo "       by git checkout would destroy these changes. Commit first." >&2
    exit "$EXIT_PRECONDITION"
  else
    echo "WARNING: stow/ has uncommitted changes. If --adopt runs, git diff will" >&2
    echo "         mix your edits with adopted files. Consider committing first." >&2
  fi
fi

# --- Tree-fold detection and resolution ---

# Returns the tree-fold target path for a package, or returns 1 if not applicable.
# Only the 4 packages that were tree-folded before --no-folding are listed.
get_fold_target() {
  case "$1" in
    claude)   echo "$HOME/.claude" ;;
    codex)    echo "$HOME/.codex" ;;
    git)      echo "$HOME/.config/git" ;;
    opencode) echo "$HOME/.config/opencode" ;;
    *)        return 1 ;;
  esac
}

# Check if a target is actually tree-folded (directory-level symlink into stow)
is_tree_folded() {
  local target="$1" pkg="$2"
  [ -L "$target" ] || return 1
  local canonical_pkg
  canonical_pkg=$(cd "$STOW_DIR/$pkg" && pwd -P)
  local abs_link
  abs_link=$(cd "$(dirname "$target")" && cd "$(readlink "$target")" && pwd -P 2>/dev/null) || return 1
  [[ "$abs_link" == "$canonical_pkg/"* ]]
}

# Resolve a tree-folded directory symlink into a real directory
resolve_tree_fold() {
  local target="$1" pkg="$2"
  local tmpdir pre_count post_count

  echo "  Resolving tree-fold: $target"
  pre_count=$(find "$target" -type f | wc -l)

  # 1. Create staging directory with random suffix (mktemp, no recovery infra)
  tmpdir=$(mktemp -d "${target}.XXXXXX")

  # 2. Copy all contents (runtime data + tracked files are co-mingled)
  #    cp -a src/. dst/ copies hidden files without needing shopt dotglob
  #    Use cp (not mv) so tracked files remain in the stow package dir
  if ! cp -a "$target"/. "$tmpdir"/; then
    echo "  ERROR: Failed to copy contents of $target" >&2
    rm -rf "$tmpdir"
    return 1
  fi

  # 3. Rename-aside: move symlink out of the way (no data-loss window)
  local aside="${target}.stow-old-$$"
  mv "$target" "$aside"

  # 4. Move staging dir to final target (atomic rename)
  mv "$tmpdir" "$target"

  # 5. Clean up the old symlink
  rm -rf "$aside"

  # 6. Clean untracked files from the stow package dir
  #    Tracked files are intact (cp, not mv). Use -fdx to also remove gitignored
  #    files — .gitignore patterns (e.g. /stow/claude/dot-claude/**/*) were
  #    defense-in-depth for the tree-fold scenario and block -fd from cleaning.
  #    Double -f removes nested git repos (e.g. claude plugins/marketplaces)
  if [ "$HEADLESS" = false ]; then
    git -C "$REPO_ROOT" clean -ffdxn -- "stow/$pkg" | head -20
  fi
  if ! git -C "$REPO_ROOT" clean -ffdx -- "stow/$pkg"; then
    echo "  WARNING: git clean failed for stow/$pkg" >&2
  fi

  post_count=$(find "$target" -type f | wc -l)
  if [ "$post_count" -lt "$pre_count" ]; then
    echo "  WARNING: File count dropped from $pre_count to $post_count" >&2
  fi

  echo "  Done: $target is now a real directory"
}

# Detect and resolve tree-folded packages before stowing
tree_fold_found=false
for pkg in "$@"; do
  fold_target=$(get_fold_target "$pkg") || continue
  if is_tree_folded "$fold_target" "$pkg"; then
    if [ "$tree_fold_found" = false ]; then
      tree_fold_found=true
      echo ""
      echo "=== Tree-folded directories detected ==="
      if [ "$HEADLESS" = false ]; then
        echo "NOTE: Stop any tools that write to tree-folded directories before proceeding."
        read -r -p "Press Enter to continue or Ctrl-C to abort..."
      else
        echo "ERROR: Tree-folded directories detected in headless mode. Aborting." >&2
        echo "  Resolve tree-folds interactively first, then re-deploy headless." >&2
        exit "$EXIT_PRECONDITION"
      fi
    fi
    if ! resolve_tree_fold "$fold_target" "$pkg"; then
      echo "  ERROR: Failed to resolve tree-fold for $pkg, skipping" >&2
    fi
  fi
done

# --- Deploy ---

STOW_FLAGS=(--dotfiles --no-folding --target="$TARGET")

cd "$STOW_DIR"

# Track adopted, deployed, and failed packages (temp files avoid subshell variable loss)
adopted_file=$(mktemp)
deployed_file=$(mktemp)
failed_file=$(mktemp)
trap 'rm -f "$adopted_file" "$deployed_file" "$failed_file"' EXIT

for pkg in "$@"; do
  # Platform guard for desktop-only packages
  if [ "$(uname -s)" != "Darwin" ]; then
    case "$pkg" in
      ghostty|cursor|launchagent)
        echo "WARNING: $pkg is macOS-only, skipping on $(uname -s)" >&2
        continue
        ;;
    esac
  fi

  echo "==> Stowing $pkg"

  # Try restow, capturing stderr for conflict analysis on failure
  if err=$(stow "${STOW_FLAGS[@]}" -R "$pkg" 2>&1); then
    echo "  Done: $pkg"
    echo "$pkg" >> "$deployed_file"
    continue
  fi

  # Error classification: only enter conflict resolution if stderr
  # contains conflict indicators. Other errors (permissions, stow bugs)
  # should fail immediately with the original error message.
  if ! grep -q "existing target" <<< "$err"; then
    echo "  ERROR: $pkg failed (not a conflict):" >&2
    # shellcheck disable=SC2001
    sed 's/^/    /' <<< "$err" >&2
    if [ "$HEADLESS" = true ]; then
      echo "$pkg" >> "$failed_file"
      continue  # best-effort: try remaining packages
    else
      exit "$EXIT_PACKAGE"
    fi
  fi

  # Remove non-stow symlinks (absolute symlinks stow cannot own)
  sed -n 's/.*existing target is not owned by stow: //p' <<< "$err" | while read -r target; do
    full="$TARGET/$target"
    if [ -L "$full" ]; then
      dest=$(readlink "$full")
      echo "  Removing non-stow symlink: $target -> $dest"
      rm -f "$full"
    fi
  done

  # Retry after symlink cleanup
  if stow "${STOW_FLAGS[@]}" -R "$pkg" 2>/dev/null; then
    echo "  Done: $pkg (after symlink cleanup)"
    echo "$pkg" >> "$deployed_file"
    continue
  fi

  # Still failing: adopt existing plain files
  echo "  Adopting existing files for $pkg..."
  if ! adopt_err=$(stow "${STOW_FLAGS[@]}" -R --adopt "$pkg" 2>&1); then
    echo "  ERROR: $pkg adopt failed:" >&2
    # shellcheck disable=SC2001
    sed 's/^/    /' <<< "$adopt_err" >&2
    if [ "$HEADLESS" = true ]; then
      echo "$pkg" >> "$failed_file"
      continue
    else
      exit "$EXIT_PACKAGE"
    fi
  fi
  echo "$pkg" >> "$adopted_file"

  if [ "$HEADLESS" = true ]; then
    # Headless: auto-restore repo versions (adopted files replaced with repo content)
    git -C "$REPO_ROOT" checkout -- "stow/$pkg/"
    echo "  Done: $pkg (adopted + auto-restored repo version)"
  else
    echo "  Done: $pkg (adopted — review diff below)"
  fi
  echo "$pkg" >> "$deployed_file"
done

# Show diffs for adopted files (interactive mode only)
if [ "$HEADLESS" = false ] && [ -s "$adopted_file" ]; then
  echo ""
  echo "=== Files adopted from target into repo ==="
  echo "Review changes below. Local file content now overwrites repo versions."
  echo ""
  cd "$REPO_ROOT"
  while read -r pkg; do
    echo "--- $pkg ---"
    git diff "stow/$pkg/" 2>/dev/null || echo "  (no changes or untracked)"
  done < "$adopted_file"
  echo ""
  echo "To keep local changes:   git add stow/<package>/"
  echo "To discard and use repo: git checkout -- stow/<package>/"
fi

# --- Post-stow validation ---

# Git hooks: ensure core.hooksPath is set for this repo
if [ -d "$REPO_ROOT/.githooks" ]; then
  _hooks_path=$(git -C "$REPO_ROOT" config --local core.hooksPath 2>/dev/null || true)
  if [ "$_hooks_path" != ".githooks" ]; then
    git -C "$REPO_ROOT" config --local core.hooksPath .githooks
    echo ""
    echo "==> Configured core.hooksPath = .githooks"
  fi
fi

# SSH: verify config parses and identity file exists
if grep -qx "ssh" "$deployed_file" 2>/dev/null; then
  echo ""
  echo "==> Validating SSH config"
  if ! ssh -G github.com >/dev/null 2>&1; then
    echo "  WARNING: SSH config may be invalid -- 'ssh -G github.com' failed" >&2
  else
    _id_file=$(ssh -G github.com 2>/dev/null | awk '/^identityfile /{print $2; exit}')
    _id_file="${_id_file/#\~/$HOME}"
    if [ -n "$_id_file" ] && [ ! -f "$_id_file" ]; then
      echo "  WARNING: SSH IdentityFile '$_id_file' does not exist" >&2
      echo "           Key must be named brett_ed25519 on all machines" >&2
    else
      echo "  SSH config OK (IdentityFile: ${_id_file##*/})"
    fi
  fi
fi

# Git local config: deploy platform-specific template if absent
if grep -qx "git" "$deployed_file" 2>/dev/null; then
  echo ""
  echo "==> Checking git local config"
  _local_cfg="$TARGET/.config/git/local"
  _platform=$(uname -s | tr '[:upper:]' '[:lower:]')
  _template="$REPO_ROOT/config/git/local.$_platform"

  if [ -L "$TARGET/.config/git" ]; then
    echo "  WARNING: ~/.config/git is tree-folded (symlink), skipping template" >&2
  elif [ -f "$_local_cfg" ]; then
    echo "  Git local config exists, skipping template deploy"
  elif [ -f "$_template" ]; then
    if cp "$_template" "$_local_cfg"; then
      echo "  Deployed git local config from local.$_platform"
    else
      echo "  WARNING: Failed to deploy git config template" >&2
    fi
  else
    echo "  No git config template for $_platform (not needed)"
  fi
fi

# Headless summary
if [ "$HEADLESS" = true ] && [ -s "$failed_file" ]; then
  echo ""
  echo "=== FAILURES ==="
  while read -r pkg; do
    echo "  FAILED: $pkg"
  done < "$failed_file"
  exit "$EXIT_PACKAGE"
fi
