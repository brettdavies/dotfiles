<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Daily Homebrew update and upgrade (macOS): runs `bu no-greedy` through
    scripts/upgrade/brew.sh. Counterpart to brew-upgrade.timer on the Linux
    server.

    launchd runs a calendar job missed during sleep on the next wake, so on a
    laptop the run usually lands when the lid opens. A greedy upgrade of a cask
    whose uninstall stanza quits its app (Ghostty, Rectangle, Telegram,
    AppCleaner) would close that app then; those casks declare auto_updates
    and update themselves, so the scheduled run leaves them to a manual `bu`.

    RunAtLoad is off so that bootstrapping the agent does not start an upgrade.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.brew-upgrade</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/bin:/bin"; exec "$HOME/dotfiles/scripts/upgrade/launchd-run.sh" brew.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
