[Unit]
Description=Box bidirectional sync (rclone bisync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH=/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/brett/dotfiles/scripts/sync/box-bisync.sh

# Hardening
NoNewPrivileges=true
PrivateTmp=true
