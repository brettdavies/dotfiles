#!/usr/bin/env bash
# agent-slot — hands out full clones of a repo ("slots") on this server, one agent task per slot, and owns every
# check before a slot is torn down. The Rex helper on the Mac, the operator's shell, and agents all call it.
#
# Usage: agent-slot <verb> [options] [--output json]
# Verbs and options: agent-slot --help, and agent-slot <verb> --help.
#
# Env (each defaults to the path in parentheses):
#   AGENT_SLOT_ROOT            slot root (~/slots)
#   AGENT_SLOT_DEV             where prime checkouts live (~/dev)
#   AGENT_SLOT_EXTRA_PRIMES    colon-separated prime checkouts outside it (~/dotfiles)
#   AGENT_SLOT_STATE_DIR       ledger and failure logs (~/.local/state/agent-slot)
#   AGENT_SLOT_RUN_DIR         the status hook's per-pane locks ($XDG_RUNTIME_DIR/agent-slot-<uid>)
#   AGENT_SLOT_CLAUDE_PROJECTS Claude's per-project directories, read only (~/.claude/projects)
#   AGENT_SLOT_MAX_PER_REPO    live slots one repo may hold (8)
#   AGENT_SLOT_LOCK_WAIT       seconds resume waits for a busy slot (30)
#   AGENT_SLOT_TRUST_SOCKET    the trust step's scratch tmux socket (agent-slot-trust)
#   AGENT_SLOT_TRUST_TIMEOUT   seconds the trust step watches Claude's screen (45)
#   AGENT_SLOT_TMUX_SOCKET     slot tmux socket name (agent-slots)
#   AGENT_SLOT_TMUX_CONF       slot tmux config (~/.config/tmux/slots.conf)
#   AGENT_SLOT_SOLUTIONS       shared solutions repo (~/dev/solutions-docs)
#   AGENT_SLOT_GIT_CRYPT_KEY   git-crypt key (~/.config/git-crypt/key)
#   AGENT_SLOT_CLAUDE_STATE    Claude's app-state file, read only (~/.claude.json)
#   AGENT_SLOT_TMUX, _CLAUDE, _GH, _GIT_CRYPT, _TRASH, _JQ, _SYSTEMCTL
#                              absolute paths that replace the binaries found on the pinned PATH

if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4))); then
  for b in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    [ -x "$b" ] && exec "$b" "$0" "$@"
  done
  echo "ERROR: needs bash >= 4.4 (running $BASH_VERSION); install it with: brew install bash" >&2
  exit 1
fi

set -euo pipefail

AS_HOME=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
AS_LIB=$AS_HOME/lib

# shellcheck source=lib/env.sh
source "$AS_LIB/env.sh"
# shellcheck source=lib/contract.sh
source "$AS_LIB/contract.sh"
# shellcheck source=lib/names.sh
source "$AS_LIB/names.sh"
# shellcheck source=lib/record.sh
source "$AS_LIB/record.sh"
# shellcheck source=lib/bounded.sh
source "$AS_LIB/bounded.sh"
# shellcheck source=lib/agentstate.sh
source "$AS_LIB/agentstate.sh"
# shellcheck source=lib/trust.sh
source "$AS_LIB/trust.sh"
# shellcheck source=lib/read.sh
source "$AS_LIB/read.sh"
# shellcheck source=lib/doctor.sh
source "$AS_LIB/doctor.sh"
# shellcheck source=lib/parity.sh
source "$AS_LIB/parity.sh"
# shellcheck source=lib/sessions.sh
source "$AS_LIB/sessions.sh"
# shellcheck source=lib/launch.sh
source "$AS_LIB/launch.sh"
# shellcheck source=lib/prstate.sh
source "$AS_LIB/prstate.sh"
# shellcheck source=lib/homescan.sh
source "$AS_LIB/homescan.sh"
# shellcheck source=lib/check.sh
source "$AS_LIB/check.sh"
# shellcheck source=lib/teardown.sh
source "$AS_LIB/teardown.sh"
# shellcheck source=lib/schema.sh
source "$AS_LIB/schema.sh"
# shellcheck source=lib/help.sh
source "$AS_LIB/help.sh"

if ! agent_slot_env "$AS_HOME"; then
  contract_no_json_tool agent-slot "$@"
  exit "$EXIT_CONFIG"
fi

# Usage: require_tools <tool...>; refuses with dependency-missing naming the first one absent.
require_tools() {
  local tool
  contract_use_tools "$@"
  for tool in "$@"; do
    [[ -n ${AS_TOOL[$tool]:-} ]] && continue
    contract_fail dependency-missing "$tool is not installed on this server" --value "$tool" \
      --command "$(_doctor_install_hint "$tool")"
  done
}

main() {
  contract_init agent-slot "$@"
  refuse_leading_output "$@"
  local verb=${1:-}
  case $verb in
    '' | -h | --help | help)
      CONTRACT_EMITTED=1
      printf '%s\n' "$USAGE"
      return 0
      ;;
    -V | --version)
      CONTRACT_EMITTED=1
      git -C "$AS_HOME" rev-parse --short HEAD 2>/dev/null || echo unknown
      return 0
      ;;
  esac
  shift
  [[ $VERBS == *" $verb "* ]] || {
    [[ " $* " != *" --output json "* && " $* " != *" --output=json "* ]] || CONTRACT_OUTPUT=json
    contract_fail usage "unknown verb: $verb" --value "$verb" --command "agent-slot --help"
  }
  CONTRACT_VERB=$verb

  local args=()
  while (($#)); do
    case $1 in
      -h | --help)
        CONTRACT_EMITTED=1
        verb_help "$verb"
        return 0
        ;;
      --output | --output=*)
        output_flag "$@"
        shift "$OUTPUT_SHIFT"
        continue
        ;;
      *) args+=("$1") ;;
    esac
    shift
  done

  case $verb in
    repos | list | doctor | schema)
      ((${#args[@]} == 0)) || usage_fail "$verb takes no arguments" "${args[0]}"
      exec </dev/null
      [[ $verb != list ]] || require_tools tmux claude
      "cmd_$verb"
      ;;
    whoami)
      if ((${#args[@]} == 2)) && [[ ${args[0]} == --path ]]; then
        WHOAMI_PATH=${args[1]}
      elif ((${#args[@]} != 0)); then
        usage_fail "whoami takes only --path DIR" "${args[0]}"
      fi
      exec </dev/null
      cmd_whoami
      ;;
    launch)
      launch_parse_args "${args[@]}"
      exec </dev/null
      cmd_launch
      ;;
    resume)
      ((${#args[@]} == 1)) || usage_fail "resume takes one slot, <repo>/<N>" "${args[*]}"
      exec </dev/null
      cmd_resume "${args[0]}"
      ;;
    check)
      ((${#args[@]} <= 1)) || usage_fail "check takes at most one slot, <repo>/<N>" "${args[*]}"
      CHECK_KEY=${args[0]:-}
      exec </dev/null
      cmd_check
      ;;
    sweep)
      SWEEP_YES=0
      if ((${#args[@]} == 1)) && [[ ${args[0]} == --yes ]]; then
        SWEEP_YES=1
      elif ((${#args[@]} != 0)); then
        usage_fail "sweep takes only --yes" "${args[*]}"
      fi
      exec </dev/null
      cmd_sweep
      ;;
    finish)
      local key=''
      FINISH_YES=0
      for arg in "${args[@]}"; do
        case $arg in
          --yes) FINISH_YES=1 ;;
          *)
            [[ -z $key ]] || usage_fail "finish takes one slot, <repo>/<N>" "$arg"
            key=$arg
            ;;
        esac
      done
      [[ -n $key ]] || usage_fail "finish needs a slot, <repo>/<N>"
      exec </dev/null
      cmd_finish "$key"
      ;;
    warm)
      warm_parse_args "${args[@]}"
      exec </dev/null
      cmd_warm "$WARM_REPO" "$WARM_COUNT"
      ;;
  esac
}

main "$@"
