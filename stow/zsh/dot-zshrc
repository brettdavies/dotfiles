# shellcheck disable=all  # zsh syntax — shellcheck only understands bash/sh
# If you come from bash you might have to change your $PATH.
# export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Source .profile if not already loaded — .zshenv normally handles this,
# but tools that bypass .zshenv (rare) still need env+PATH. Matches the
# sentinel pattern in stow/bash/dot-bashrc. Skipping the redundant
# re-source is what prevents the config/shell/*.sh files from running
# twice and duplicating PATH entries.
if [ -z "${DOTFILES_SHELL_DIR:-}" ] && [ -f "$HOME/.profile" ]; then
    source "$HOME/.profile"
fi

# If not running interactively, don't do anything further.
# Secrets and environment are already loaded via .profile above.
[[ $- == *i* ]] || return

# Source shared shell functions from repo (no symlink needed)
if [ -n "${DOTFILES_SHELL_DIR:-}" ] && [ -f "${DOTFILES_SHELL_DIR}/shell-functions" ]; then
    source "${DOTFILES_SHELL_DIR}/shell-functions"
fi

ZSH_THEME="powerlevel10k/powerlevel10k"
# zsh-autosuggestions and zsh-syntax-highlighting are NOT loaded via omz
# plugins because brew ships them without the `<name>.plugin.zsh` file
# omz's is_plugin() expects. Both are sourced directly at the end of
# this file from $HOMEBREW_PREFIX/share/ instead (Homebrew's documented
# approach). See BOOTSTRAP.md "macOS — Brew Zsh Plugins" for context.
plugins=(git)

# Unified compinit: set ZSH_COMPDUMP before sourcing oh-my-zsh so it uses our
# cache path. This avoids a redundant second compinit call (~170ms savings).
# oh-my-zsh also handles zrecompile via a lock-dir pattern.
[[ ! -d ~/.zsh/cache ]] && mkdir -p ~/.zsh/cache
export ZSH_COMPDUMP=~/.zsh/cache/zcompdump

# Add completion directories to fpath BEFORE oh-my-zsh's compinit sees them.
# Uses $HOMEBREW_PREFIX (set by brew shellenv in .profile) instead of slow
# `brew --prefix` subprocess (~16ms each call).
if [[ -n "${HOMEBREW_PREFIX:-}" ]]; then
    [[ -d "$HOMEBREW_PREFIX/share/zsh/site-functions" ]] && fpath=("$HOMEBREW_PREFIX/share/zsh/site-functions" $fpath)
    [[ -d "$HOMEBREW_PREFIX/share/zsh-completions" ]]    && fpath=("$HOMEBREW_PREFIX/share/zsh-completions" $fpath)
fi
fpath=($HOME/.docker/completions $fpath)

source "$ZSH/oh-my-zsh.sh"

# Safety net: compile the completion dump if oh-my-zsh's lock-dir pattern
# failed (stale .lock dir blocks zrecompile). A compiled .zwc loads in ~2ms
# vs ~170ms for the uncompiled text dump.
if [[ -s "$ZSH_COMPDUMP" && ( ! -s "${ZSH_COMPDUMP}.zwc" || "$ZSH_COMPDUMP" -nt "${ZSH_COMPDUMP}.zwc" ) ]]; then
    zcompile "$ZSH_COMPDUMP" 2>/dev/null
fi

# Wire tmuxinator completions to the mux wrapper
(( $+functions[_tmuxinator] || $+commands[tmuxinator] )) && compdef mux=tmuxinator

# History configuration
HISTSIZE=10000
SAVEHIST=10000
HISTFILE=~/.zsh_history

# History options: ignore duplicates, ignore commands starting with space, add timestamps
setopt HIST_IGNORE_DUPS     # Ignore duplicate commands
setopt HIST_IGNORE_SPACE    # Ignore commands starting with space
setopt HIST_FIND_NO_DUPS    # Ignore duplicate commands in history
setopt HIST_REDUCE_BLANKS   # Remove unnecessary blanks
setopt HIST_VERIFY          # Verify history commands before execution
setopt SHARE_HISTORY        # Share history between sessions
setopt APPEND_HISTORY       # Append history instead of overwriting
setopt EXTENDED_HISTORY     # Add timestamps to history

# Additional useful zsh options
setopt AUTO_CD              # Auto cd to directories (type directory name to cd)
setopt AUTO_PUSHD           # Auto push directories onto stack
setopt PUSHD_IGNORE_DUPS    # Ignore duplicates in directory stack
setopt PUSHD_SILENT         # Don't print directory stack after pushd/popd
setopt INTERACTIVE_COMMENTS # Allow comments in interactive shell
setopt LONG_LIST_JOBS       # List jobs in long format
setopt MULTIOS              # Multiple output redirection
setopt GLOB_STAR_SHORT      # Enable **/*.txt syntax (shorter than **/*.txt)
setopt NUMERIC_GLOB_SORT    # Sort numeric filenames numerically
setopt EXTENDED_GLOB        # Enable extended glob patterns (used by dotfiles scripts)

# Modern history options (zsh 5.0.8+)
# Use fcntl for history locking (better performance and reliability)
if [[ "${ZSH_VERSION%%.*}" -ge 5 ]] && [[ "${ZSH_VERSION#*.}" =~ ^[0-9]+ ]] && [[ "${ZSH_VERSION#*.}" -ge 8 ]]; then
    setopt HIST_FCNTL_LOCK
fi

# Better word splitting in history (zsh 5.0+)
setopt HIST_LEX_WORDS

# Don't store history command itself in history
setopt HIST_NO_STORE

# History filtering: only save successful commands (exit code 0)
# Store commands temporarily and only add successful ones to history
_PENDING_HIST_CMD=""

# Prevent all commands from being added automatically
zshaddhistory() {
    # Store the command temporarily
    _PENDING_HIST_CMD="$1"
    # Don't add to history yet - we'll add it in precmd if it succeeds
    return 1  # Prevent automatic addition
}

# After command execution, add to history only if it succeeded
_add_successful_cmd() {
    local exit_code=$?
    
    # If command succeeded and we have a pending command, add it to history
    if [[ $exit_code -eq 0 && -n "$_PENDING_HIST_CMD" ]]; then
        # Add the command to history manually
        print -s "$_PENDING_HIST_CMD"
    fi
    # Clear pending command
    _PENDING_HIST_CMD=""
}

# Add hook
autoload -Uz add-zsh-hook
add-zsh-hook precmd _add_successful_cmd

# OSC 7 support: Report current directory to terminal (for better terminal integration)
# Uses shared function from .shell-functions
_precmd_osc7() {
    _osc7_report_directory
}
add-zsh-hook precmd _precmd_osc7

