# shellcheck shell=bash
# Sourced by both bash and zsh — both support [[ ]] and BASH_SOURCE

# Resolve the dotfiles repo root by following this file's symlink back to stow/shell/
if [ -n "${BASH_SOURCE[0]}" ]; then
    # BASH_SOURCE doesn't resolve symlinks — follow the link manually
    _PROFILE_REAL="${BASH_SOURCE[0]}"
    if [ -L "$_PROFILE_REAL" ]; then
        _PROFILE_REAL=$(readlink "$_PROFILE_REAL")
        if [[ "$_PROFILE_REAL" != /* ]]; then
            _PROFILE_REAL="$(dirname "${BASH_SOURCE[0]}")/$_PROFILE_REAL"
        fi
    fi
    _DOTFILES_ROOT="$(cd "$(dirname "$_PROFILE_REAL")/../.." && pwd)"
elif [ -L "$HOME/.profile" ]; then
    # Zsh and other shells: resolve the ~/.profile symlink
    _PROFILE_SOURCE=$(readlink "$HOME/.profile")
    if [[ "$_PROFILE_SOURCE" != /* ]]; then
        _PROFILE_SOURCE="$HOME/$_PROFILE_SOURCE"
    fi
    _DOTFILES_ROOT="$(cd "$(dirname "$_PROFILE_SOURCE")/../.." && pwd)"
else
    _DOTFILES_ROOT=""
fi

# Shell helpers live in config/shell/, separate from stow-managed dotfiles
_CONFIG_DIR="$_DOTFILES_ROOT/config/shell"

# NOT exported: sentinel must only prevent double-sourcing within the same
# shell process, not leak into child processes (which need their own .profile)
# shellcheck disable=SC2034  # used by .zshenv, .zshrc, .bashrc
DOTFILES_SHELL_DIR="$_CONFIG_DIR"

if [ -n "$_DOTFILES_ROOT" ] && [ -d "$_CONFIG_DIR" ]; then
    for _f in "$_CONFIG_DIR"/*.sh; do
        # shellcheck disable=SC1090
        [ -f "$_f" ] && . "$_f"
    done
    unset _f
fi

unset _DOTFILES_ROOT _CONFIG_DIR _PROFILE_REAL _PROFILE_SOURCE

# Initialize Homebrew/Linuxbrew shell environment
# Must come before ~/.secrets because secrets use `op read` from Homebrew PATH
if [[ -z "${HOMEBREW_PREFIX:-}" ]]; then
    export HOMEBREW_NO_ENV_HINTS=1
    if [ -f /opt/homebrew/bin/brew ]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [ -f /usr/local/bin/brew ]; then
        eval "$(/usr/local/bin/brew shellenv)"
    elif [ -f /home/linuxbrew/.linuxbrew/bin/brew ]; then
        eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
    fi
fi

# Secrets symlinked via stow (stow/secrets/dot-secrets -> ~/.secrets)
# Requires Homebrew PATH above for `op` CLI (1Password service account)
if [ -f ~/.secrets ]; then
    # shellcheck disable=SC1090
    . ~/.secrets
fi

# Ensure ~/.local/bin is in PATH for user-installed binaries
# Must come after Homebrew so local wrappers can shadow Homebrew binaries
case ":${PATH}:" in
    *:"$HOME/.local/bin":*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# Rust/Cargo environment
if [ -f "$HOME/.cargo/env" ]; then
    # shellcheck disable=SC1091
    . "$HOME/.cargo/env"
fi

# GPG terminal for commit signing (shared across all shells)
# tty fails in non-interactive shells (cron, some SSH commands) — suppress gracefully
GPG_TTY=$(tty 2>/dev/null) || true
# Preferred editor — set here so both bash and zsh inherit it
# macOS (desktop): VS Code
# Linux (headless): micro (terminal editor, no GUI)
case "$(uname -s)" in
    Darwin)
        if command -v code >/dev/null 2>&1; then
            EDITOR="code"
        elif command -v micro >/dev/null 2>&1; then
            EDITOR=$(command -v micro)
        fi
        ;;
    *)
        if command -v micro >/dev/null 2>&1; then
            EDITOR=$(command -v micro)
        fi
        ;;
esac
if [ -n "${EDITOR:-}" ]; then
    export EDITOR
    export VISUAL=$EDITOR
fi

# Ollama updater (requires sudo — replaces root-owned binary and restarts systemd service)
alias ollama-update='curl -fsSL https://ollama.com/install.sh | sudo sh'

export GPG_TTY
