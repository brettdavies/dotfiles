[Unit]
Description=GBrain nightly dream cycle (lint, extract, facts, takes, consolidate)
Documentation=file:///home/brett/gbrain/docs/guides/cron-schedule.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH=/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/brett/dotfiles/scripts/sync/gbrain-dream.sh
StandardOutput=append:%h/.gbrain/dream.log
StandardError=append:%h/.gbrain/dream.err

# Hardening
NoNewPrivileges=true
PrivateTmp=true
