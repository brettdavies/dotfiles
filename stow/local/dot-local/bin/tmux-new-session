#!/usr/bin/env bash
# Create or attach to a tmuxinator-managed 3-pane dev session for a repo.
# Usage: tmux-new-session <session-name> <repo-path>
#
# Layout:
#   ┌──────────┬──────────────────────────┐
#   │          │   shell  (top,    2/3 h) │
#   │  yazi    │                          │
#   │ (1/3 w,  ├──────────────────────────┤
#   │ full h)  │   lazygit (bottom, 1/3 h)│
#   └──────────┴──────────────────────────┘
#
# Behavior:
#   1. If no tmuxinator config exists for <session-name> in the dotfiles
#      tmuxinator package, generate one and re-stow.
#   2. If the session is already running, attach. Otherwise start it via
#      `tmuxinator start` (invoked directly so shell-function aliases like
#      `mux` aren't required in the script's subshell).

set -euo pipefail

SESSION="${1:?Usage: $0 <session-name> <repo-path>}"
REPO="${2:?Usage: $0 <session-name> <repo-path>}"

if [ ! -d "$REPO" ]; then
  echo "Error: repo path '$REPO' does not exist" >&2
  exit 1
fi

DOTFILES="${DOTFILES:-$HOME/dotfiles}"
TMUXINATOR_PKG="$DOTFILES/stow/tmuxinator/dot-config/tmuxinator"
CONFIG_FILE="$TMUXINATOR_PKG/$SESSION.yml"

# Tilde-relativize REPO when it sits under $HOME so the generated config
# stays portable across machines with different $HOME values. The literal
# `~/` is intentional — it gets written into the YAML config and tmuxinator
# expands it at session-start time, not the script's shell.
# shellcheck disable=SC2088
case "$REPO" in
  "$HOME"/*) ROOT="~/${REPO#"$HOME"/}" ;;
  *) ROOT="$REPO" ;;
esac

if [ ! -f "$CONFIG_FILE" ]; then
  echo "Creating tmuxinator config: $CONFIG_FILE"
  cat >"$CONFIG_FILE" <<EOF
name: $SESSION
root: $ROOT

windows:
  - main:
      layout: main-vertical
      panes:
        - command -v y >/dev/null && y || yazi
        -
        - lazygit

on_project_first_start: |
  (
    sleep 0.3
    tmux resize-pane -t $SESSION:main.1 -x "33%"
    tmux resize-pane -t $SESSION:main.3 -y "33%"
  ) & disown
EOF
  "$DOTFILES/scripts/stow-deploy" tmuxinator >/dev/null
  echo "✅ Config created and stowed"
fi

if tmux has-session -t "$SESSION" 2>/dev/null; then
  echo "Session '$SESSION' already running — attaching"
  exec tmux attach -t "$SESSION"
fi

exec tmuxinator start "$SESSION"
