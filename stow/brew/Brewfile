# Essential packages for dotfiles setup

# Required taps
tap "gromgit/brewtils"
tap "oven-sh/bun"

# oh-my-zsh theme
brew "powerlevel10k"

# oh-my-zsh plugins
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "zsh-completions"

# Development tools
brew "libpq"
brew "gh"
brew "node"
brew "oven-sh/bun/bun"
brew "uv"

# Code quality & utilities
brew "bash"
brew "ripgrep"
brew "jq"
brew "tree"
brew "wget"
brew "coreutils"
brew "git-crypt"
brew "yamllint"
brew "ast-grep"
brew "yq"
brew "markdownlint-cli2"

# Agent token compression — `rtk` PreToolUse hook for Claude Code lives in
# stow/claude/dot-claude/settings.json. PR #62 installed the hook; this
# line installs the binary so the hook actually runs on every machine.
brew "rtk"

# Terminal multiplexer
brew "tmux"
brew "tmuxinator"

# macOS-only utilities — `brew bundle` skips formulae that don't exist for the current OS,
# but listing them separately documents intent and avoids confusing "not found" warnings.
brew "terminal-notifier" if OS.mac?
brew "gromgit/brewtils/taproom" if OS.mac?

# macOS-only casks (Homebrew Cask is macOS-only — `brew bundle` skips these on Linux)
cask "1password-cli"
cask "claude-code"
cask "ghostty"
cask "font-meslo-lg-nerd-font"
cask "appcleaner"
cask "docker-desktop"
cask "rectangle"

# VS Code extensions (macOS — Cursor on Linux uses its own extension sync)
vscode "anthropic.claude-code"
