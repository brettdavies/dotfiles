#!/usr/bin/env bash
# Converge gstack's per-machine config on the values this repo wants.
#
# ~/.gstack/config.yaml is not a stow package: gstack-config rewrites it
# through a temp file and rename, which detaches a stow symlink on the first
# write, and gstack persists its own first-run answers and per-host
# bookkeeping there. The intent lives in the table below instead, and this
# script reads each key and writes only the ones that drifted, so it is safe
# on every session start and after every gstack ./setup.
#
# Usage: gstack-config-apply [--check|--list]
#   (none)   write drifted keys, one `key: was -> now` line each
#   --check  report drifted keys without writing; exit 1 when any drifted
#   --list   print the managed `key value` table
#
# Exit 0 without output when gstack is not installed on this host.

set -euo pipefail

CONFIG="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills/gstack/bin/gstack-config"

# Every off-machine sink `gstack-egress grants` names, the review path that
# ships diffs to a second vendor, the hook gstack would otherwise register into
# the shared settings.json, and the update path: announce and pull.
MANAGED='
telemetry off
artifacts_sync_mode off
memorable_recall off
redact_prepush_hook false
redact_repo_visibility unknown
codex_reviews disabled
pair_agent off
transcript_ingest_mode off
gstack_contributor false
timeline_stop_hook no
update_check true
auto_upgrade true
'

mode="${1:-apply}"
case "$mode" in
  apply | --check | --list) ;;
  *)
    echo "usage: gstack-config-apply [--check|--list]" >&2
    exit 2
    ;;
esac

if [ "$mode" = "--list" ]; then
  printf '%s' "$MANAGED" | sed '/^$/d'
  exit 0
fi

[ -x "$CONFIG" ] || exit 0

drifted=0
while read -r key want; do
  [ -n "$key" ] || continue
  have=$("$CONFIG" get "$key" 2>/dev/null || true)
  [ "$have" != "$want" ] || continue
  drifted=1
  if [ "$mode" = "--check" ]; then
    printf '%s: %s (want %s)\n' "$key" "${have:-<unset>}" "$want"
  else
    "$CONFIG" set "$key" "$want" >/dev/null
    printf '%s: %s -> %s\n' "$key" "${have:-<unset>}" "$want"
  fi
done <<<"$MANAGED"

[ "$mode" != "--check" ] || [ "$drifted" -eq 0 ]
