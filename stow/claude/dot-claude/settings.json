      "Bash(lsof:*)",
      "Bash(mkdir:*)",
      "Bash(nproc:*)",
      "Bash(nvidia-smi:*)",
      "Bash(pandoc:*)",
      "Bash(printf:*)",
      "Bash(pwd:*)",
      "Bash(qmd:*)",
      "Bash(readlink:*)",
      "Bash(realpath:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(sort:*)",
      "Bash(ss:*)",
      "Bash(stat:*)",
      "Bash(swiftformat:*)",
      "Bash(tail:*)",
      "Bash(tee:*)",
      "Bash(test:*)",
      "Bash(top:*)",
      "Bash(touch:*)",
      "Bash(tr:*)",
      "Bash(trash:*)",
      "Bash(tree:*)",
      "Bash(type:*)",
      "Bash(uname:*)",
      "Bash(uniq:*)",
      "Bash(uptime:*)",
