# shellcheck shell=bash
# Shared shell functions for bash and zsh
# This file is sourced by both .bashrc and .zshrc

# y: yazi wrapper that cds the shell to yazi's last directory on exit.
# Without this, quitting yazi leaves the shell in its original cwd; with it,
# yazi becomes a real navigation tool — browse to any tree, press q, the
# shell is there. Use `y` instead of `yazi` for interactive sessions.
#
# Quit keys (yazi defaults — documented at yazi-rs.github.io/docs/quick-start):
#   q   quit AND write cwd-file (shell follows)
#   Q   quit WITHOUT writing cwd-file (shell stays put)
#
# Canonical pattern from the yazi README, plus `[ -d "$cwd" ]` defensive
# guard to reject any malformed cwd (e.g., trailing-whitespace edge cases).
y() {
    local tmp cwd
    tmp="$(mktemp -t yazi-cwd.XXXXXX)"
    yazi "$@" --cwd-file="$tmp"
    IFS= read -r -d '' cwd < "$tmp" 2>/dev/null
    rm -f -- "$tmp"
    if [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && [ -d "$cwd" ]; then
        builtin cd -- "$cwd" || return
    fi
}

# OSC 7 support: Report current directory to terminal (for better terminal integration)
# This allows terminals like Ghostty to track the current working directory
# Format: \033]7;file://hostname/path\033\\
# Usage: Call this function from shell-specific prompt hooks
_osc7_report_directory() {
    # Try HOSTNAME first (bash default), then HOST (zsh default), fallback to localhost
    local hostname="${HOSTNAME:-${HOST:-localhost}}"
    printf '\033]7;file://%s%s\033\\' "$hostname" "$PWD"
}

# ollama-update: replace the Ollama binary and restart its systemd service.
# Lives here rather than in .profile because the name carries a hyphen, which
# POSIX does not allow in a function name — dash rejects the definition
# outright and abandons the rest of the file it appears in. This file is read
# only by interactive bash and zsh, both of which accept the name.
ollama-update() { curl -fsSL https://ollama.com/install.sh | sudo sh; }

# bu: bring Homebrew fully current — refresh the formula index, upgrade every
# formula and cask, then reclaim the disk the superseded versions held.
#
# Interactive-only, like ollama-update above. Cask upgrades shell out to
# installers that prompt for sudo, so the run wants a terminal either way, and a
# two-character name has no business in the non-interactive fragments where it
# would shadow whatever a script's own `bu` was meant to reach.
#
# Flags verified against a Homebrew 7.0.0 build rather than recalled:
#
# `-y` belongs on the upgrade and nowhere else. Ask mode has been the default
# for `brew upgrade` since 6.0.0 — 5.1.15 still took an opt-in `--ask`, 6.0.0
# replaced it with `-y, --no-ask` and "Ask mode is the default" — so without it
# the command stops for confirmation and an unattended run hangs. `brew update`
# is the one with no such flag: it exits 1 on `invalid option: -y`, which under
# `&&` would strand everything after it.
#
# `--greedy` is what makes the cask half real: it adds the casks declaring
# `version :latest` or `auto_updates true` that an upgrade otherwise skips, which
# is most of them. It needs no `--cask` pass beside it — with no named arguments
# `Homebrew::Cmd::Upgrade` leaves both `only_upgrade_formulae` and
# `only_upgrade_casks` false and runs the formula and cask paths in turn, so a
# second `brew upgrade --cask` run is a strictly narrower repeat of work done.
#
# It also overrides the per-cask opt-out, which is worth knowing before reaching
# for that setting to stop fighting a self-updating app: 7.0.0 made
# `brew upgrade` honour $HOMEBREW_NO_UPGRADE_AUTO_UPDATES_CASKS, but the variable
# documents itself as not affecting `--greedy`, so this function upgrades those
# casks whether or not it is set.
#
# No platform guard: Homebrew Cask is macOS-only, but `--greedy` is parsed the
# same on Linux and simply matches nothing there, so both flags are a no-op
# rather than an error on the Linux hosts in this fleet.
bu() {
    brew update || return
    brew upgrade --greedy -y || return
    brew cleanup
}
