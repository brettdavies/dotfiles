#!/usr/bin/env bash
#
# github-stars-pdf - Convert allowlisted PDFs from the starred clones to markdown for qmd
#
# github-stars leaves PDFs out of every clone. The few that are real reference material are listed in PDF_SOURCES;
# this command fetches each one from its clone on demand (git show), converts it with the markdown-convert skill's
# mc-pdf, and writes the markdown under STARS_DIR/_pdf-markdown/<owner>/<repo>/<path>.md, where qmd's stars
# collection indexes it. A PDF converts only when its blob is new or changed (.manifest records the blob each
# markdown came from), so a run with no PDF changes calls no converter. systemd starts it after each successful stars
# sync (OnSuccess=).
#
# Usage: github-stars-pdf [owner/repo:path.pdf ...]
#        With arguments, those entries replace the built-in list for this run.

set -euo pipefail

BASE_DIR="${STARS_DIR:-$HOME/github-stars}"
OUT_DIR="$BASE_DIR/_pdf-markdown"
MANIFEST="$OUT_DIR/.manifest"
CONVERTER="${PDF_TO_MARKDOWN:-$HOME/.claude/skills/markdown-convert/skills/mc-pdf/mc-pdf.sh}"

PDF_SOURCES=(
    "sarwarbeing-ai/Agentic_Design_Patterns:Agentic_Design_Patterns.pdf"
    "sourdough-bread/asd-ste100-checker:ASD-STE100-ISSUE-9.pdf"
    "huggingface/distil-whisper:Distil_Whisper.pdf"
    "baidu/Unlimited-OCR:Unlimited-OCR.pdf"
    "google/longfellow-zk:docs/static/reviews/Longfellow_report_2025_08_18.pdf"
    "google/longfellow-zk:docs/static/reviews/Longfellow_security_2025_12_15.pdf"
    "MajorLeagueBaseball/google-cloud-mlb-hackathon:datasets/mlb-statsapi-docs/MLB-Official Rules-2024.pdf"
    "MajorLeagueBaseball/google-cloud-mlb-hackathon:datasets/mlb-statsapi-docs/MLB-StatsAPI - GUMBO - User Guide.pdf"
    "MajorLeagueBaseball/google-cloud-mlb-hackathon:datasets/mlb-statsapi-docs/MLB-StatsAPI - Lookup Values.pdf"
    "MajorLeagueBaseball/google-cloud-mlb-hackathon:datasets/mlb-statsapi-docs/MLB-StatsAPI-Getting Started.pdf"
    "MajorLeagueBaseball/google-cloud-mlb-hackathon:datasets/mlb-statsapi-docs/MLB-StatsAPI-Hydrations.pdf"
    "je-suis-tm/machine-learning:Wisdom of Crowds project/Regularized Least Squares to Remove Reviewer Bias.pdf"
)

usage() {
    cat <<'EOF'
Usage: github-stars-pdf [owner/repo:path.pdf ...]

Convert the allowlisted PDFs in the starred clones to markdown under
$STARS_DIR/_pdf-markdown (default ~/github-stars/_pdf-markdown). Only new or
changed PDFs are converted. With arguments, those entries replace the
built-in list for this run.

ENVIRONMENT:
  STARS_DIR        Base directory of the clones (default: ~/github-stars)
  PDF_TO_MARKDOWN  Converter, called as <converter> <file.pdf> <out_dir>
                   (default: the markdown-convert skill's mc-pdf.sh)
  GH_TOKEN         Token for on-demand fetches from GitHub (default: gh auth token)
EOF
}

# Run git against a clone, routing a GitHub origin's on-demand fetches over HTTPS with the token, since the job runs
# without an SSH agent and the clones' origin is the SSH URL.
_git() {
    local repo="$1"
    shift
    local origin
    origin=$(git -C "$BASE_DIR/$repo" remote get-url origin 2>/dev/null || true)
    if [[ "$origin" == *github.com[:/]* ]]; then
        git -C "$BASE_DIR/$repo" -c "remote.origin.url=https://x-access-token@github.com/$repo.git" "$@"
    else
        git -C "$BASE_DIR/$repo" "$@"
    fi
}

# The manifest line recorded for an entry, matched on the whole entry.
_manifest_line() {
    awk -v e="$1" 'substr($0, index($0, " ") + 1) == e { print; exit }' "$MANIFEST"
}

main() {
    case "${1:-}" in
        -h | --help)
            usage
            exit 0
            ;;
        -*)
            echo "github-stars-pdf: unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
    local -a sources=("${PDF_SOURCES[@]}")
    [[ $# -gt 0 ]] && sources=("$@")

    if [[ -z "${GH_TOKEN:-}" ]]; then
        GH_TOKEN=$(gh auth token 2>/dev/null || true)
    fi
    if [[ -n "${GH_TOKEN:-}" ]]; then
        export GIT_CONFIG_COUNT=1
        export GIT_CONFIG_KEY_0="http.https://github.com/.extraheader"
        GIT_CONFIG_VALUE_0="AUTHORIZATION: basic $(printf 'x-access-token:%s' "$GH_TOKEN" | base64 -w0)"
        export GIT_CONFIG_VALUE_0
    fi

    mkdir -p "$OUT_DIR"
    touch "$MANIFEST"
    work=$(mktemp -d)
    trap 'rm -rf "${work:-}"' EXIT

    local entry repo path blob dest name previous converted=0 unchanged=0 skipped=0 failed=0
    local -a keep=() manifest=()
    for entry in "${sources[@]}"; do
        repo="${entry%%:*}"
        path="${entry#*:}"
        dest="$OUT_DIR/$repo/${path%.*}.md"
        keep+=("$dest")
        if [[ ! -d "$BASE_DIR/$repo/.git" ]]; then
            echo "github-stars-pdf: skip $repo: not cloned" >&2
            skipped=$((skipped + 1))
            continue
        fi
        if ! blob=$(git -C "$BASE_DIR/$repo" rev-parse --verify -q "HEAD:$path"); then
            echo "github-stars-pdf: skip $entry: not in the repo" >&2
            skipped=$((skipped + 1))
            continue
        fi
        if [[ -s "$dest" ]] && [[ "$(_manifest_line "$entry")" == "$blob $entry" ]]; then
            manifest+=("$blob $entry")
            unchanged=$((unchanged + 1))
            continue
        fi
        name=$(basename "$path" .pdf)
        rm -rf "${work:?}/in" "${work:?}/out"
        mkdir -p "$work/in" "$work/out"
        if _git "$repo" show "HEAD:$path" >"$work/in/$name.pdf" &&
            "$CONVERTER" "$work/in/$name.pdf" "$work/out" >/dev/null 2>&1 &&
            [[ -s "$work/out/$name.md" ]]; then
            mkdir -p "$(dirname "$dest")"
            mv "$work/out/$name.md" "$dest"
            manifest+=("$blob $entry")
            converted=$((converted + 1))
            echo "github-stars-pdf: converted $entry" >&2
        else
            echo "github-stars-pdf: failed to convert $entry" >&2
            previous=$(_manifest_line "$entry")
            [[ -n "$previous" ]] && manifest+=("$previous")
            failed=$((failed + 1))
        fi
    done

    # Markdown for entries no longer listed leaves the index with them.
    local md k listed
    while IFS= read -r -d '' md; do
        listed=false
        for k in "${keep[@]}"; do
            [[ "$md" == "$k" ]] && listed=true && break
        done
        [[ "$listed" == true ]] || rm -f "$md"
    done < <(find "$OUT_DIR" -type f -name '*.md' -print0)
    find "$OUT_DIR" -mindepth 1 -type d -empty -delete

    if [[ ${#manifest[@]} -gt 0 ]]; then
        printf '%s\n' "${manifest[@]}" >"$MANIFEST"
    else
        : >"$MANIFEST"
    fi
    echo "github-stars-pdf: converted $converted, unchanged $unchanged, skipped $skipped, failed $failed" >&2
    [[ $failed -eq 0 ]]
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
