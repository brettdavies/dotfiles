[Unit]
Description=Mirror the vault's agent workspace to the NAS
ConditionHost=bigdaddy

[Service]
Type=oneshot
Environment=PATH=/home/linuxbrew/.linuxbrew/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/obsidian-vault/scripts/sync-to-pool.sh

# Hardening. No PrivateTmp= or other namespace setting: in a user unit it maps root to nobody, and ssh, which rsync
# runs here, then rejects every root-owned file /etc/ssh/ssh_config includes (tests/user-unit-sandboxing.bats).
NoNewPrivileges=true
