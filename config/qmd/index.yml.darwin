# qmd collections (macOS) — deployed by stow-deploy.
# To update from the template: delete ~/.config/qmd/index.yml and re-run
# scripts/stow-deploy. Day-to-day edits go through `qmd collection add/remove`,
# which write through to the live file.
#
# The home directory is substituted at deploy time (qmd does not expand ~ or
# env vars in collection paths — they are fed to the globber verbatim, so the
# deployed file must hold absolute paths).
#
# The models block pins the same three refs as index.yml.linux. Both platforms
# run the brettdavies/qmd fork through the stowed dispatcher, and an unpinned
# daemon resolves whatever defaults its build ships, so leaving them out here
# would let one host embed into a different vector space than the other.
collections:
  solutions:
    path: ${HOME}/dev/solutions-docs
    pattern: "**/*.md"
  skills:
    path: ${HOME}/dev/agent-skills
    pattern: "**/*.md"
  meum:
    path: ${HOME}/dev
    pattern: meum*/**/*.md
  dev:
    path: ${HOME}/dev
    pattern: "**/*.md"
models:
  embed: hf:ggml-org/embeddinggemma-300M-GGUF/embeddinggemma-300M-Q8_0.gguf
  generate: hf:tobil/qmd-query-expansion-1.7B-gguf/qmd-query-expansion-1.7B-q4_k_m.gguf
  rerank: hf:ggml-org/Qwen3-Reranker-0.6B-Q8_0-GGUF/qwen3-reranker-0.6b-q8_0.gguf
