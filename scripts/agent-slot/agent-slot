if ! agent_slot_env "$AS_HOME"; then
  contract_no_json_tool agent-slot "$@"
  exit "$EXIT_CONFIG"
fi

# Usage: require_tools <tool...>; refuses with dependency-missing naming the first one absent.
require_tools() {
  local tool
  contract_use_tools "$@"
  for tool in "$@"; do
    [[ -n ${AS_TOOL[$tool]:-} ]] && continue
    contract_fail dependency-missing "$tool is not installed on this server" --value "$tool" \
      --command "$(_doctor_install_hint "$tool")"
  done
}

main() {
  contract_init agent-slot "$@"
  refuse_leading_output "$@"
  local verb=${1:-}
  case $verb in
    '' | -h | --help | help)
      CONTRACT_EMITTED=1
      printf '%s\n' "$USAGE"
      return 0
      ;;
    -V | --version)
      CONTRACT_EMITTED=1
      git -C "$AS_HOME" rev-parse --short HEAD 2>/dev/null || echo unknown
      return 0
      ;;
  esac
  shift
  [[ $VERBS == *" $verb "* ]] || {
    [[ " $* " != *" --output json "* && " $* " != *" --output=json "* ]] || CONTRACT_OUTPUT=json
    contract_fail usage "unknown verb: $verb" --value "$verb" --command "agent-slot --help"
  }
  CONTRACT_VERB=$verb

  local args=()
  while (($#)); do
    case $1 in
      -h | --help)
        CONTRACT_EMITTED=1
        verb_help "$verb"
        return 0
        ;;
      --output | --output=*)
        output_flag "$@"
        shift "$OUTPUT_SHIFT"
        continue
        ;;
      *) args+=("$1") ;;
    esac
    shift
  done

  case $verb in
    repos | list | doctor | schema)
      ((${#args[@]} == 0)) || usage_fail "$verb takes no arguments" "${args[0]}"
      exec </dev/null
      [[ $verb != list ]] || require_tools tmux claude
      "cmd_$verb"
      ;;
    whoami)
      if ((${#args[@]} == 2)) && [[ ${args[0]} == --path ]]; then
        WHOAMI_PATH=${args[1]}
      elif ((${#args[@]} != 0)); then
        usage_fail "whoami takes only --path DIR" "${args[0]}"
      fi
      exec </dev/null
      cmd_whoami
      ;;
    launch)
      launch_parse_args "${args[@]}"
      exec </dev/null
      cmd_launch
      ;;
    resume)
      ((${#args[@]} == 1)) || usage_fail "resume takes one slot, <repo>/<N>" "${args[*]}"
      exec </dev/null
      cmd_resume "${args[0]}"
      ;;
    adopt)
      adopt_parse_args "${args[@]}"
      exec </dev/null
      cmd_adopt
      ;;
    reopen)
      reopen_parse_args "${args[@]}"
      exec </dev/null
      cmd_reopen
      ;;
    check)
      ((${#args[@]} <= 1)) || usage_fail "check takes at most one slot, <repo>/<N>" "${args[*]}"
      CHECK_KEY=${args[0]:-}
      exec </dev/null
      cmd_check
      ;;
    sweep)
      SWEEP_YES=0 SWEEP_AUTO=0
      case ${args[*]} in
        '') ;;
        --yes) SWEEP_YES=1 ;;
        '--yes --auto' | '--auto --yes') SWEEP_YES=1 SWEEP_AUTO=1 ;;
        *) usage_fail "sweep takes only --yes, and --auto with it" "${args[*]}" ;;
      esac
      exec </dev/null
      cmd_sweep
      ;;
    release)
      RELEASE_WHY=
      if ((${#args[@]} == 2)) && [[ ${args[0]} == --not-yet ]]; then
        RELEASE_WHY=${args[1]}
        [[ -n ${RELEASE_WHY//[[:space:]]/} ]] || usage_fail "--not-yet needs the reason the slot is not ready" "''"
      elif ((${#args[@]} != 0)); then
        usage_fail "release takes only --not-yet WHY; it releases the slot it runs in" "${args[0]}"
      fi
      exec </dev/null
      cmd_release
      ;;
    finish)
      local key=''
      FINISH_YES=0 FINISH_WHEN_IDLE=0 FINISH_ALLOW_OPEN_PR=0
      for arg in "${args[@]}"; do
        case $arg in
          --yes) FINISH_YES=1 ;;
          --when-idle) FINISH_WHEN_IDLE=1 ;;
          --allow-open-pr) FINISH_ALLOW_OPEN_PR=1 ;;
          *)
            [[ -z $key ]] || usage_fail "finish takes one slot, <repo>/<N>" "$arg"
            key=$arg
            ;;
        esac
      done
      [[ -n $key ]] || usage_fail "finish needs a slot, <repo>/<N>"
      ((FINISH_WHEN_IDLE == 0 || FINISH_YES == 1)) || usage_fail "--when-idle goes with --yes" --when-idle
      ((FINISH_ALLOW_OPEN_PR == 0 || FINISH_YES == 1)) || usage_fail "--allow-open-pr goes with --yes" --allow-open-pr
      exec </dev/null
      cmd_finish "$key"
      ;;
    warm)
      warm_parse_args "${args[@]}"
      exec </dev/null
      cmd_warm "$WARM_REPO" "$WARM_COUNT"
      ;;
  esac
}

main "$@"
