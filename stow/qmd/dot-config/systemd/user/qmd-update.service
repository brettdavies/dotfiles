[Unit]
Description=QMD index update (cleanup + re-index all collections)

[Service]
Type=oneshot
Environment=PATH=/home/brett/.bun/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/sh -c 'qmd cleanup 2>/dev/null; qmd update'

# Hardening
NoNewPrivileges=true
PrivateTmp=true
