#!/bin/sh
# qmd dispatcher — selects the right fork launcher per OS.
#
# Linux:  fork bash launcher at ~/dev/qmd/qmd
# macOS:  fork cross-platform launcher at ~/dev/qmd/bin/qmd
#
# Both expose the brettdavies/qmd fork CLI (qmd serve + QMD_REMOTE_URL). The
# wrapper is stowed at ~/.local/bin/qmd so callers get a stable path on either
# OS, invariant to repo moves. On macOS the serve daemon is kept resident by
# the com.user.qmd-serve LaunchAgent.

case "$(uname -s)" in
  Darwin)
    exec "$HOME/dev/qmd/bin/qmd" "$@"
    ;;
  Linux)
    exec "$HOME/dev/qmd/qmd" "$@"
    ;;
  *)
    echo "qmd: unsupported OS: $(uname -s)" >&2
    exit 1
    ;;
esac
