# shellcheck disable=all  # zsh syntax — shellcheck only understands bash/sh
# ~/.zprofile — sourced by zsh login shells AFTER /etc/zprofile.
#
# On macOS, /etc/zprofile runs `/usr/libexec/path_helper -s`, which
# PREPENDS /usr/bin, /bin, /usr/local/bin to PATH — clobbering the
# Homebrew bin ordering established by .zshenv → .profile and pushing
# /opt/homebrew/bin behind system paths. `brew doctor` flags this.
#
# This file repairs the order by removing any existing brew bin entries
# from $path (zsh's array-tied view of PATH) and prepending a fresh pair
# at positions 1-2. Idempotent: rerunning produces the same result.
#
# Darwin-gated: Linux has no path_helper and Linuxbrew already lands at
# the front via .profile. Running this on Linux would be a harmless
# no-op, but the gate makes intent explicit and matches the platform
# checks in stow/shell/dot-profile.

[ "$(uname -s)" = "Darwin" ] || return 0
[ -n "${HOMEBREW_PREFIX:-}" ] || return 0

# zsh ties $PATH to the array $path. ${path[@]:#PATTERN} excludes elements
# matching PATTERN — used here to strip any existing brew entries before
# prepending fresh ones at the front.
path=("${path[@]:#$HOMEBREW_PREFIX/bin}")
path=("${path[@]:#$HOMEBREW_PREFIX/sbin}")
path=("$HOMEBREW_PREFIX/bin" "$HOMEBREW_PREFIX/sbin" "${path[@]}")

# Keg-only Homebrew Ruby lives under $HOMEBREW_PREFIX/opt and /lib, not /bin,
# so the block above misses it and path_helper leaves its bin + gem binstubs
# behind /usr/bin. That demotes Bundler to macOS system Ruby 2.6 / Bundler 1.x,
# which predates the supply-chain cooldown policy (needs >= 4.0.13). Re-assert
# the same way. The (N) glob qualifier yields nothing — rather than erroring —
# when the gems dir is absent (Ruby not installed).
if [ -d "$HOMEBREW_PREFIX/opt/ruby/bin" ]; then
  path=("${path[@]:#$HOMEBREW_PREFIX/lib/ruby/gems/*/bin}")
  path=("${path[@]:#$HOMEBREW_PREFIX/opt/ruby/bin}")
  path=("$HOMEBREW_PREFIX"/lib/ruby/gems/*/bin(N) "$HOMEBREW_PREFIX/opt/ruby/bin" "${path[@]}")
fi
