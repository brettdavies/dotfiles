#!/usr/bin/env bash
# Single source of truth for which bats suites run and in what order.
#
# Consumed by three callers that must not drift apart:
#   .github/workflows/bats.yml  --all      (CI)
#   .githooks/pre-push          --all      (mirrors CI)
#   .githooks/pre-commit        <file>...  (staged test files only)
#
# Usage:
#   scripts/run-tests --all       run the perf suite, then the main suite
#   scripts/run-tests FILE...     run the given .bats files
#
# Exit 0 when everything passes, 1 on a test failure, 2 on usage error,
# 3 when bats is not installed.

set -euo pipefail

EXIT_FAILURE=1
EXIT_USAGE=2
EXIT_DEPENDENCY=3

if [ "$#" -eq 0 ]; then
  echo "usage: $0 --all | $0 FILE..." >&2
  exit "$EXIT_USAGE"
fi

if ! command -v bats >/dev/null 2>&1; then
  echo "run-tests: bats-core not installed" >&2
  echo "           install with: brew install bats-core" >&2
  exit "$EXIT_DEPENDENCY"
fi

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

# git hands hooks a GIT_DIR, and from a worktree it is absolute. An absolute
# GIT_DIR outranks `-C`, so a test building a fixture with `git -C "$sandbox"`
# drives this repository instead of the fixture. Scrub the git environment for
# the test run only, so the caller's own git calls keep resolving normally.
_bats() {
  env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR -u GIT_INDEX_FILE \
    -u GIT_PREFIX -u GIT_OBJECT_DIRECTORY \
    bats "$@"
}

if [ "$1" = "--all" ]; then
  [ "$#" -eq 1 ] || {
    echo "run-tests: --all takes no other arguments" >&2
    exit "$EXIT_USAGE"
  }

  # Startup latency first, while nothing else has loaded the machine. Measured
  # after the main suite, the several hundred shells it spawns push interactive
  # zsh past its budget with nothing about the config having changed.
  if compgen -G "tests/perf/*.bats" >/dev/null; then
    _bats tests/perf/*.bats || exit "$EXIT_FAILURE"
  fi
  if compgen -G "tests/*.bats" >/dev/null; then
    _bats tests/*.bats || exit "$EXIT_FAILURE"
  fi
  exit 0
fi

targets=()
for f in "$@"; do
  case "$f" in
    *.bats) [ -f "$f" ] && targets+=("$f") ;;
  esac
done

[ "${#targets[@]}" -gt 0 ] || exit 0
_bats "${targets[@]}" || exit "$EXIT_FAILURE"
