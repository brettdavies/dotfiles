[Unit]
Description=Nightly autocommit for knowledge repos (solutions-docs, agent-skills)

[Service]
Type=oneshot
Environment=PATH=/home/linuxbrew/.linuxbrew/bin:/home/brett/.bun/bin:/home/brett/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/brett
ExecStart=/home/brett/dotfiles/scripts/nightly-autocommit.sh

# Hardening. No PrivateTmp= or other namespace setting: in a user unit it maps root to nobody, and ssh, which git fetch
# and push run here, then rejects every root-owned file /etc/ssh/ssh_config includes (tests/user-unit-sandboxing.bats).
NoNewPrivileges=true
