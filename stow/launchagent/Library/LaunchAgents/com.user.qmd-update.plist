<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    QMD index update — macOS port of qmd-update.service + qmd-update.timer
    (Linux systemd, see stow/qmd/dot-config/systemd/user/).

    Runs `qmd update` every 5 minutes and at load time, keeping the BM25 +
    vector index in sync with current collection contents. Cleanup (vacuum,
    cache drop) belongs to the nightly com.user.qmd-cleanup agent only: a
    VACUUM of a multi-GB index every five minutes rewrites the whole file
    each cycle and drops the query-expansion cache before it can be reused.

    PATH covers both qmd install paths: the stow wrapper at ~/.local/bin/qmd
    (which dispatches to ~/dev/qmd/qmd, the brettdavies fork) and the
    upstream package at ~/.cache/bun/bin/qmd (installed via `bun install -g
    @tobilu/qmd`). First match wins, so the fork takes precedence if both
    exist.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.qmd-update</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>PATH="$HOME/.local/bin:$HOME/.cache/bun/bin:/opt/homebrew/bin:/usr/bin:/bin"; exec qmd update &gt;&gt; "$HOME/dotfiles/scripts/qmd-launchd/logs/qmd-update.log" 2&gt;&gt; "$HOME/dotfiles/scripts/qmd-launchd/logs/qmd-update.error.log"</string>
    </array>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
