[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[user]
	name = Brett
	email = brettdavies@users.noreply.github.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJ/qfP/m4bJUxjY6dGpLl21h76OiGusKl7ya0Tba1rs6
[core]
	editor = $EDITOR
[gpg]
	format = ssh
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[gpg "ssh"]
	# Cross-platform wrapper in ~/.local/bin/ (on PATH via .profile)
	program = op-ssh-sign-wrapper
	allowedSignersFile = ~/.config/git/allowed_signers
[url "git@github.com:"]
	insteadOf = https://github.com/
[url "git@gist.github.com:"]
	insteadOf = https://gist.github.com/
[include]
	# Per-host overrides (e.g., user.signingkey on headless Linux)
	path = ~/.config/git/local
