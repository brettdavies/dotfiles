      "Bash(find:*)",
      "Bash(free:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gio trash:*)",
      "Bash(git -C:*)",
      "Bash(git add:*)",
      "Bash(git archive:*)",
      "Bash(git bisect:*)",
      "Bash(git blame:*)",
      "Bash(git branch:*)",
      "Bash(git check-ignore:*)",
      "Bash(git checkout:*)",
      "Bash(git clone:*)",
      "Bash(git commit:*)",
      "Bash(git config:*)",
      "Bash(git-crypt:*)",
      "Bash(git describe:*)",
      "Bash(git diff:*)",
      "Bash(git diff-tree:*)",
      "Bash(git fetch:*)",
      "Bash(git grep:*)",
      "Bash(git-lfs:*)",
      "Bash(git log:*)",
      "Bash(git ls-tree:*)",
      "Bash(git mv:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git rev-list:*)",
      "Bash(git rev-parse:*)",
      "Bash(git shortlog:*)",
      "Bash(git show:*)",
      "Bash(git stash:*)",
      "Bash(git status:*)",
