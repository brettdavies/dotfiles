#!/bin/sh
# Wrapper for the bundled Obsidian CLI on a headless host.
# The CLI reaches the running app through $XDG_RUNTIME_DIR/.obsidian-cli.sock.
# Login sessions get XDG_RUNTIME_DIR from pam_systemd; agent shells, cron, and
# other non-login callers do not, so default it to the user's runtime directory.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
exec /opt/Obsidian/obsidian-cli "$@"
