#!/usr/bin/env bash
# Auto-unlock git-crypt if key is available, then relink the stow packages this
# update changed (lib/restow.sh)
# Bypass: git checkout --no-verify (if supported by your git version)

set -euo pipefail

if command -v git-crypt >/dev/null 2>&1; then
  if [ -f ~/.config/git-crypt/key ]; then
    # Fast sentinel check: if a known encrypted file is binary, repo is locked.
    # Avoids expensive `git-crypt status` which scans every file (200-500ms).
    sentinel="stow/secrets/dot-secrets"
    if [ -f "$sentinel" ] && ! grep -qI '' "$sentinel" 2>/dev/null; then
      git-crypt unlock ~/.config/git-crypt/key 2>/dev/null || true
    fi
  fi
fi

# $3 is 1 for a branch checkout and 0 for a file checkout; a clone or a new
# worktree passes an all-zero object id as the previous HEAD. This hook's exit
# status becomes git checkout's, so a failed restow must not reach it.
if [ "${3:-0}" = 1 ]; then
  case "$1" in
    *[!0]*) "$BASH" "$(dirname "$0")/lib/restow.sh" "$1" "$2" || true ;;
  esac
fi

# Chain Git LFS hook (core.hooksPath overrides .git/hooks/)
command -v git-lfs >/dev/null 2>&1 && git lfs post-checkout "$@"
