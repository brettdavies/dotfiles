# qmd collections (Linux) — deployed by stow-deploy.
# To update from the template: delete ~/.config/qmd/index.yml and re-run
# scripts/stow-deploy. Day-to-day edits go through `qmd collection add/remove`,
# which write through to the live file.
#
# The home directory is substituted at deploy time (qmd does not expand ~ or
# env vars in collection paths — they are fed to the globber verbatim, so the
# deployed file must hold absolute paths).
#
# Ordering invariant: local collections MUST precede NAS-backed ones. qmd
# indexes sequentially and aborts on the first missing directory, so a listed
# NAS path crashes the run and skips every collection after it when the NAS is
# offline. Keep all home-local collections above the nas-* block.
collections:
  vault:
    path: ${HOME}/obsidian-vault
    pattern: "**/*.md"
  stars:
    path: ${HOME}/github-stars
    pattern: "**/*.md"
  solutions:
    path: ${HOME}/dev/solutions-docs
    pattern: "**/*.md"
  skills:
    path: ${HOME}/dev/agent-skills
    pattern: "**/*.md"
  meum:
    path: ${HOME}/dev
    pattern: meum*/**/*.md
  streams-control:
    path: ${HOME}/box/TX-AI/streams-control
    pattern: "**/*.md"
  nas-asupersync:
    path: /mnt/nas/bigdaddy-backup/asupersync
    pattern: "**/*.md"
  nas-docs:
    path: /mnt/nas/bigdaddy-backup/docs
    pattern: "**/*.md"
  nas-memory:
    path: /mnt/nas/bigdaddy-backup/memory
    pattern: "**/*.md"
  nas-polymarket-analysis:
    path: /mnt/nas/bigdaddy-backup/polymarket-analysis
    pattern: "**/*.md"
  nas-research:
    path: /mnt/nas/bigdaddy-backup/research
    pattern: "**/*.md"
  nas-rust_scriptbots:
    path: /mnt/nas/bigdaddy-backup/rust_scriptbots
    pattern: "**/*.md"
  nas-scripts:
    path: /mnt/nas/bigdaddy-backup/scripts
    pattern: "**/*.md"
  nas-skills:
    path: /mnt/nas/bigdaddy-backup/skills
    pattern: "**/*.md"
models:
  embed: hf:ggml-org/embeddinggemma-300M-GGUF/embeddinggemma-300M-Q8_0.gguf
  generate: hf:tobil/qmd-query-expansion-1.7B-gguf/qmd-query-expansion-1.7B-q4_k_m.gguf
  rerank: hf:ggml-org/Qwen3-Reranker-0.6B-Q8_0-GGUF/qwen3-reranker-0.6b-q8_0.gguf
