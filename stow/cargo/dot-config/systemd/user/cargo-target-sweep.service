[Unit]
Description=Delete Rust build output no build has used in two weeks

[Service]
Type=oneshot
Environment=PATH=%h/.cargo/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/cargo-target-sweep
Nice=19
IOSchedulingClass=idle

# Hardening
NoNewPrivileges=true
PrivateTmp=true
