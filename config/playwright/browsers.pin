# The system browser set: one line per field, "key value...". Read only through
# scripts/playwright-browsers/lib/pin.sh, which accepts nothing but the shapes
# it lists. Download hosts live in the scripts, never here.
#
# Moving the pin by hand is in docs/runbooks/playwright-browser-launch.md.

cft-version 157.0.8103.38
webkit-revision 2388
ffmpeg-revision 1013

# The Playwright library this repo's tests run, and the newest release whose
# browsers.json supplied the WebKit and ffmpeg revisions above; each with the
# sha256 of its playwright-core npm tarball.
