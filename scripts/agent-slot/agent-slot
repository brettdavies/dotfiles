#!/usr/bin/env bash
# agent-slot — hands out clones of a repo ("slots") on this server, one agent task per slot, and owns every
# check before a slot is torn down. The Rex helper on the Mac, the operator's shell, and agents all call it.
#
# Usage: agent-slot <verb> [options] [--output json]
# Verbs and options: agent-slot --help, and agent-slot <verb> --help.
#
# Env (each defaults to the path in parentheses):
#   AGENT_SLOT_ROOT            slot root (~/slots)
#   AGENT_SLOT_DEV             where prime checkouts live (~/dev)
#   AGENT_SLOT_EXTRA_PRIMES    colon-separated prime checkouts outside it (~/dotfiles)
#   AGENT_SLOT_STATE_DIR       ledger and failure logs (~/.local/state/agent-slot)
#   AGENT_SLOT_RUN_DIR         the status hook's per-pane locks ($XDG_RUNTIME_DIR/agent-slot-<uid>)
#   AGENT_SLOT_CLAUDE_PROJECTS Claude's per-project directories, read only (~/.claude/projects)
#   AGENT_SLOT_MAX_PER_REPO    live slots one repo may hold (8)
#   AGENT_SLOT_LOCK_WAIT       seconds resume waits for a busy slot (30)
#   AGENT_SLOT_TRUST_SOCKET    the trust step's scratch tmux socket (agent-slot-trust)
#   AGENT_SLOT_TRUST_TIMEOUT   seconds the trust step watches Claude's screen (45)
#   AGENT_SLOT_TMUX_SOCKET     slot tmux socket name (agent-slots)
#   AGENT_SLOT_TMUX_CONF       slot tmux config (~/.config/tmux/slots.conf)
#   AGENT_SLOT_SOLUTIONS       shared solutions repo (~/dev/solutions-docs)
#   AGENT_SLOT_GIT_CRYPT_KEY   git-crypt key (~/.config/git-crypt/key)
#   AGENT_SLOT_CLAUDE_STATE    Claude's app-state file, read only (~/.claude.json)
#   AGENT_SLOT_REX_CLIENTS     space-separated ssh aliases of the Macs whose Rex a launch or teardown pushes a restore
#                              to (bretts-air); empty pushes to none
#   AGENT_SLOT_REX_CLIENT      the Rex client whose helper ran this verb, which the push skips; the helper sets it
#   AGENT_SLOT_PUSH_CONNECT_TIMEOUT  seconds a push waits for a Mac's ssh to connect (5)
#   AGENT_SLOT_PUSH_TIMEOUT    seconds one push may take in all (60)
#   AGENT_SLOT_PUSH_WAIT       1 to wait for a verb's pushes before it exits, for a caller nothing waits on (0)
#   AGENT_SLOT_RELEASE_WAIT    seconds a released slot's teardown waits for its agent to go idle (3600)
#   AGENT_SLOT_RELEASE_POLL    seconds between that teardown's looks at the agent (5)
#   AGENT_SLOT_RELEASE_REMIND  seconds after an agent says it is not ready to release before the sweep reminds it (1800)
#   AGENT_SLOT_RELEASE_ID      in the finish a release starts, the id of that release; release sets it
#   AGENT_SLOT_TMUX, _CLAUDE, _GH, _GIT_CRYPT, _TRASH, _JQ, _SYSTEMCTL, _SSH, _FIND
#                              absolute paths that replace the binaries found on the pinned PATH
#   XDG_DATA_HOME              holds the trash a torn-down clone is purged from, trash-cli's home trash
#                              (~/.local/share/Trash)

if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4))); then
  for b in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    [ -x "$b" ] && exec "$b" "$0" "$@"
  done
  echo "ERROR: needs bash >= 4.4 (running $BASH_VERSION); install it with: brew install bash" >&2
  exit 1
fi

set -euo pipefail

AS_HOME=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
AS_LIB=$AS_HOME/lib

# shellcheck source=lib/env.sh
source "$AS_LIB/env.sh"
# shellcheck source=lib/contract.sh
source "$AS_LIB/contract.sh"
# shellcheck source=lib/names.sh
source "$AS_LIB/names.sh"
