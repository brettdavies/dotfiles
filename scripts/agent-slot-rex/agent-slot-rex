#!/usr/bin/env bash
# agent-slot-rex — the Rex half of agent slots, run on the Linux server beside the slots and its own Rex server. It
# runs inside Rex tabs and panes and from the timers: it starts an agent through `agent-slot`, keeps each pane attached
# to its slot's tmux session, and keeps one Rex tab per live slot in that repo's session. Every slot decision is
# agent-slot's; this helper only calls it and moves tabs. On macOS it runs a slot verb on the Linux server's helper
# over ssh, so a Rex.app action acts there.
#
# Usage: agent-slot-rex <verb> [options] [--output json]
# Verbs and options: agent-slot-rex --help, and agent-slot-rex <verb> --help.
#
# Env (defaults in lib/settings.sh):
#   AGENT_SLOT_REX_SERVER         the Linux server's ssh alias, which the Mac runs verbs on
#   AGENT_SLOT_REX_CLIENT         the name the helper gives agent-slot, whose push then skips the reconcile run next
#   AGENT_SLOT_REX_AGENT_SLOT     the agent-slot command
#   AGENT_SLOT_REX_REXURRECT      the rexurrect command
#   AGENT_SLOT_REX_SELF           the helper path every pane runs
#   AGENT_SLOT_REX_SSH            the ssh binary
#   AGENT_SLOT_REX_PS             the ps binary
#   AGENT_SLOT_REX_TMUX           the tmux binary
#   AGENT_SLOT_REX_SYSTEMCTL      the systemctl binary
#   AGENT_SLOT_REX_HOMEBREW       the Homebrew prefix, whose bin moves to the front of PATH
#   AGENT_SLOT_REX_APP_PATHS      where to look for the rex CLI when REX_BIN_DIR has none, colon-separated
#   AGENT_SLOT_REX_STATE_DIR      the state directory: logs, the reconcile journal, the start-up record
#   AGENT_SLOT_REX_RETRY_DELAY    seconds between the start-up step's probes of the Rex server, and between an attach's
#                                 resumes
#   AGENT_SLOT_REX_LOCK_WAIT      seconds a restore, sweep, or finish waits for the one ahead of it
#   AGENT_SLOT_REX_RECONCILE_STALE  seconds after which doctor calls the reconcile journal's newest pass stale
#   AGENT_SLOT_REX_STARTUP_WAIT   seconds the start-up step waits for a loading Rex server to answer
#   AGENT_SLOT_REX_REXURRECT_BOUND  seconds the start-up step lets rexurrect's restore run
#   AGENT_SLOT_REX_STARTUP_LIMIT  the age past which a pass reconciles a Rex server that has no start-up record
#   AGENT_SLOT_REX_VERIFIED_VERSIONS  the verified-versions file
#   AGENT_SLOT_REX_PRIMES         the prime map: each repo's prime tmux session
#   AGENT_SLOT_REX_LOGIN_SHELL    the shell a prime tab becomes when its client detaches, $SHELL by default
#   AGENT_SLOT_REX_SHOWN_WAIT     seconds a tab a key opened waits for the app to show it
#   AGENT_SLOT_REX_SHOWN_HOLD     seconds such a tab, never shown, waits for Enter before it closes itself
#   AGENT_SLOT_REX_PRIME_WAIT     seconds the start-up step waits for a prime tab it re-attached to show its client
#   REX_BIN_DIR                   where the rex CLI lives; Rex sets it in its terminals
#   AGENT_SLOT_JQ                 the jaq or jq binary

if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4))); then
  for b in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    [ -x "$b" ] && exec "$b" "$0" "$@"
  done
  echo "ERROR: needs bash >= 4.4 (running $BASH_VERSION); install it with: brew install bash" >&2
  exit 1
fi

set -euo pipefail

AR_HOME=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
AR_LIB=$AR_HOME/lib

# shellcheck source=lib/settings.sh
source "$AR_LIB/settings.sh"
# shellcheck source=../agent-slot/lib/contract.sh
source "$AR_HOME/../agent-slot/lib/contract.sh"
# shellcheck source=../agent-slot/lib/names.sh
source "$AR_HOME/../agent-slot/lib/names.sh"
# shellcheck source=lib/server.sh
source "$AR_LIB/server.sh"
# shellcheck source=lib/rex.sh
source "$AR_LIB/rex.sh"
# shellcheck source=lib/lock.sh
source "$AR_LIB/lock.sh"
# shellcheck source=lib/journal.sh
source "$AR_LIB/journal.sh"
# shellcheck source=lib/reconcile.sh
source "$AR_LIB/reconcile.sh"
# shellcheck source=lib/startup.sh
source "$AR_LIB/startup.sh"
# shellcheck source=lib/reattach.sh
source "$AR_LIB/reattach.sh"
# shellcheck source=lib/launch.sh
source "$AR_LIB/launch.sh"
# shellcheck source=lib/attach.sh
source "$AR_LIB/attach.sh"
# shellcheck source=lib/prime.sh
source "$AR_LIB/prime.sh"
# shellcheck source=lib/doctor.sh
source "$AR_LIB/doctor.sh"
# shellcheck source=lib/finish.sh
source "$AR_LIB/finish.sh"
# shellcheck source=lib/forward.sh
source "$AR_LIB/forward.sh"
# shellcheck source=lib/help.sh
source "$AR_LIB/help.sh"

AGENT_SLOT_JQ=${AGENT_SLOT_JQ:-$(command -v jaq || command -v jq || true)}
if [[ -z $AGENT_SLOT_JQ ]] || ! command -v -- "$AGENT_SLOT_JQ" >/dev/null; then
  contract_no_json_tool agent-slot-rex "$@"
  exit "$EXIT_CONFIG"
fi

rex_find || true

CONTRACT_REPO=$AR_HOME
CONTRACT_LOG_DIR=$AR_LOG_DIR
CONTRACT_TOOL_PATHS[rex]=${AR_REX:-rex}
CONTRACT_TOOL_PATHS[ssh]=$AR_SSH
CONTRACT_TOOL_PATHS[tmux]=$AR_TMUX
CONTRACT_TOOL_PATHS[agent-slot]=$AR_AGENT_SLOT
CONTRACT_CONFIG=$(contract_json -n -c --arg server "$AR_SERVER" --arg client "$AR_CLIENT" --arg state "$AR_STATE" \
  --arg rex "$AR_REX" '{server: $server, client: $client, state_dir: $state,
    rex: (if $rex == "" then null else $rex end)}')

main() {
  contract_init agent-slot-rex "$@"
  CONTRACT_VERB=agent-slot-rex
  refuse_leading_output "$@"
  local verb=${1:-}
  case $verb in
    '' | -h | --help | help)
      CONTRACT_EMITTED=1
      printf '%s\n' "$USAGE"
      return 0
      ;;
  esac
  shift
  [[ $VERBS == *" $verb "* ]] || {
    [[ " $* " != *" --output json "* && " $* " != *" --output=json "* ]] || CONTRACT_OUTPUT=json
    contract_fail usage "unknown verb: $verb" --value "$verb" --command "agent-slot-rex --help"
  }
  CONTRACT_VERB=$verb

  local args=()
  while (($#)); do
    case $1 in
      -h | --help)
        CONTRACT_EMITTED=1
        verb_help "$verb"
        return 0
        ;;
      --output | --output=*)
        output_flag "$@"
        shift "$OUTPUT_SHIFT"
        continue
        ;;
      *) args+=("$1") ;;
    esac
    shift
  done
  [[ $AR_OS != Darwin ]] || forward_verb "$verb" "${args[@]}"

  case $verb in
    launch)
      launch_parse_args "${args[@]}"
      cmd_launch
      ;;
    prime)
      ((${#args[@]} == 1)) || usage_fail "prime takes a repo" "${args[*]}"
      cmd_prime "${args[0]}"
      ;;
    attach)
      ((${#args[@]} == 2)) || usage_fail "attach takes a slot or a prime and a pane: <repo>/<N> or <repo>/prime, claude|files|git" "${args[*]}"
      cmd_attach "${args[0]}" "${args[1]}"
      ;;
    restore)
      case ${args[*]} in
        '') cmd_restore ;;
        --tab) cmd_restore_tab ;;
        --at-start) cmd_restore_at_start ;;
        '--by push' | '--by poll') cmd_restore "${args[1]}" ;;
        *) usage_fail "restore takes --tab, --at-start, or --by push|poll" "${args[*]}" ;;
      esac
      ;;
    sweep)
      ((${#args[@]} == 0)) || usage_fail "sweep takes no arguments" "${args[0]}"
      cmd_sweep
      ;;
    finish)
      if ((${#args[@]} == 5)) && [[ ${args[0]} == --tab && ${args[1]} == --session && ${args[3]} == --block ]]; then
        cmd_finish_tab "${args[2]}" "${args[4]}"
      elif ((${#args[@]} == 1)) && [[ ${args[0]} =~ ^$SLOT_KEY_PATTERN$ ]]; then
        cmd_finish "${args[0]}"
      else
        usage_fail "finish takes a slot, <repo>/<N>, or --tab --session ID --block ID" "${args[*]}"
      fi
      ;;
    doctor)
      ((${#args[@]} == 0)) || usage_fail "doctor takes no arguments" "${args[0]}"
      cmd_doctor
      ;;
  esac
}

main "$@"
