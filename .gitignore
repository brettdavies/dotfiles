# Sensitive files - never commit these
*.key
*.pem
*.p12

# Note: stow/ssh/dot-ssh/config is now encrypted with git-crypt, so it's safe to commit
# Note: stow/secrets/dot-secrets is now encrypted with git-crypt, so it's safe to commit
# Note: stow/git/dot-config/git/allowed_signers is now encrypted with git-crypt, so it's safe to commit

# History files
*.zsh_history
*.bash_history
*.history
*.zcompdump*

# Temporary files
*.tmp
*.bak
*.swp
*.swo
*~

# Log files
scripts/sync/logs/*.log
scripts/qmd-launchd/logs/*.log
scripts/qmd-launchd/logs/*.error.log

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# IDE files
.cursor/
.vscode/
.idea/
*.sublime-*

# Backup files
*.backup
*.backup.*

# Claude/other AI tool configs (may contain sensitive info)
.claude.json
.claude.json.backup

# Other potentially sensitive files
.webui_secret_key
.lmstudio-home-pointer

# The global ~/.config/git/ignore blocks AGENTS.md everywhere to prevent
# accidental commits of per-project AGENTS.md files. Negate for stow sources
# that deploy global agent instructions to a tool's config dir.
!stow/codex/dot-codex/AGENTS.md

# gbrain source-routing dotfile. The canonical slug for this repo is
# force-committed at the working-tree root; this rule prevents a fresh
# `gbrain init` on a re-clone from accidentally committing a different
# slug if the brain hasn't been provisioned with the canonical source ID.
# See gbrain's brain-routing convention (`--source`, `GBRAIN_SOURCE`,
# `.gbrain-source`).
.gbrain-source
