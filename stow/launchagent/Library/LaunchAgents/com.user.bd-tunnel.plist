<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Dev-port tunnel (macOS). Holds `ssh -N bd-tunnel` open so the dev ports
    that host entry forwards reach the Linux server from the Mac's localhost
    with no SSH tab open.

    ssh exits once its keepalives find the connection dead after a sleep or a
    network change, and KeepAlive opens a new one; ThrottleInterval spaces
    those attempts while the server is unreachable. launchd-run.sh appends
    ssh's standard error, which names any forward refused for a busy local
    port, to ~/Library/Logs/bd-tunnel.error.log, and cuts that log to its last
    1 MiB each time ssh starts.

    ssh binds its forwards only when it connects, so a refused forward stays
    down after its port frees until the next connection;
    `launchctl kickstart -k "gui/$(id -u)/com.user.bd-tunnel"` makes one at once.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.bd-tunnel</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/bin:/bin"; exec "$HOME/dotfiles/scripts/launchd-run.sh" bd-tunnel.log ssh -N bd-tunnel</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
