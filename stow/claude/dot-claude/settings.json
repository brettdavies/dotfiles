      "Bash(uv build:*)",
      "Bash(uv cache:*)",
      "Bash(uv export:*)",
      "Bash(uv init:*)",
      "Bash(uv lock:*)",
      "Bash(uv pip:*)",
      "Bash(uv python:*)",
      "Bash(uv remove:*)",
      "Bash(uv self:*)",
      "Bash(uv sync:*)",
      "Bash(uv tool:*)",
      "Bash(uv tree:*)",
      "Bash(uv venv:*)",
      "Bash(uv version:*)",
      "Bash(uvx:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(whoami:*)",
      "Bash(xcbeautify:*)",
