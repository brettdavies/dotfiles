<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    PATH is set explicitly because a LaunchAgent inherits no interactive shell
    environment: the sync script's `#!/usr/bin/env bash` and its rsync both
    resolve through it.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.devtosync</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/bin:/bin"; exec "$HOME/dotfiles/scripts/launchd-run.sh" devtosync.log "$HOME/dotfiles/scripts/sync/sync_dev_to_icloud.sh"</string>
    </array>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
