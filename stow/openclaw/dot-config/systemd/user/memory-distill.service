[Unit]
Description=Weekly MEMORY.md distillation — promote, decay, budget enforcement
After=memory-extract.service
# Requires: ~/obsidian-vault/Areas/openclaw/scripts/memory-distill.sh

[Service]
Type=oneshot
ExecStart=/home/brett/obsidian-vault/Areas/openclaw/scripts/memory-distill.sh
TimeoutStartSec=300
Environment=HOME=/home/brett
Environment=PATH=/home/brett/.local/bin:/home/brett/.npm-global/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin

# Hardening
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
