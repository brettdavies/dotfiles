#!/usr/bin/env bash
# Wrapper to block AI agents from merging PRs into main, anyone from opening a PR
# on a repository under a PR freeze, and any checkout, inside an agent slot, of a
# PR head another person owns. All other gh commands (including pr merge to
# non-main branches) pass through.

self="${BASH_SOURCE[0]}"

# exec keeps the PID, so the marker matching $$ means the PATH walk below
# handed this wrapper back to itself. A child that the real gh launches (an
# extension, a credential helper) inherits the marker under a different PID
# and passes through.
if [[ "${GH_MERGE_GUARD_PID:-}" == "$$" ]]; then
  echo "FATAL: $self re-entered itself (pid $$): the PATH walk resolved this wrapper as the real gh" >&2
  exit 1
fi

# Find real gh by walking PATH, skipping this wrapper under any spelling
# (symlinked alias dir, trailing slash, a checkout's stow tree on PATH) and
# any separate copy of it (a worktree or scratch clone deploys the same
# script under another inode). The real gh is a binary, so a candidate that
# carries the guard marker is a wrapper.
find_real_gh() {
  local IFS=':'
  for dir in $PATH; do
    [[ "$dir/gh" -ef "$self" ]] && continue
    grep -qs 'GH_MERGE_GUARD_PID' "$dir/gh" && continue
    [[ -x "$dir/gh" ]] && {
      echo "$dir/gh"
      return
    }
  done
  echo "ERROR: cannot find real gh binary" >&2
  return 1
}

real_gh=$(find_real_gh) || exit 1

# Refuse to open a pull request, or a stack of them, on a repository listed in
# the PR freeze file: one owner/repo per line, `#` comments, and an empty or
# missing file freezes nothing. A freeze holds while work that must not reach a
# maintainer yet is built on a fork. In a clone of a fork, gh and gh-stack
# resolve an unqualified target through `gh repo set-default`, which usually
# names the parent, so with no explicit target any remote pointing at a frozen
# repo refuses the call.
freeze_file="${GH_PR_FREEZE_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/gh/pr-freeze.txt}"
frozen=()
if [[ -r "$freeze_file" ]]; then
  while IFS= read -r line || [[ -n "$line" ]]; do
    line=${line%%#*}
    line=${line//[[:space:]]/}
    [[ -n "$line" ]] && frozen+=("$(printf '%s' "$line" | tr '[:upper:]' '[:lower:]')")
  done <"$freeze_file"
fi

repo_slug() {
  local r
  r=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
  r=${r#https://github.com/}
  r=${r#http://github.com/}
  r=${r#ssh://git@github.com/}
  r=${r#git@github.com:}
  r=${r#github.com/}
  r=${r%/}
  r=${r%.git}
  printf '%s' "$r"
}

# Prints the frozen repo that $1 names, if any.
frozen_hit() {
  local want f
  want=$(repo_slug "$1")
  for f in "${frozen[@]}"; do
    [[ "$want" == "$f" ]] && {
      printf '%s' "$f"
      return 0
    }
  done
  return 1
}

refuse_frozen() {
  echo "Blocked: $1 is under a PR freeze ($freeze_file). No pull request or PR stack may be opened there until Brett lifts it." >&2
  echo "Name the fork explicitly: gh pr create -R <owner>/<fork>, or GH_REPO=<owner>/<fork> gh stack submit. Do not edit the freeze file to get past this; ask Brett." >&2
  exit 1
}

check_pr_freeze() {
  local explicit="" method="" has_fields=false graphql=false endpoint="" input="" prev="" arg hit url target
  for arg in "$@"; do
    case "$prev" in
      -R | --repo) explicit=$arg ;;
      -X | --method) method=$arg ;;
      --input) input=$arg ;;
    esac
    case "$arg" in
      --repo=*) explicit=${arg#--repo=} ;;
      -R?*) explicit=${arg#-R} ;;
      --method=*) method=${arg#--method=} ;;
      -X?*) method=${arg#-X} ;;
      -f | -F | --field | --raw-field | --input | -f?* | -F?* | --field=* | --raw-field=* | --input=*) has_fields=true ;;
      graphql | /graphql) graphql=true ;;
    esac
    [[ "$arg" == --input=* ]] && input=${arg#--input=}
    [[ "$arg" =~ ^/?repos/([^/]+/[^/?]+)/pulls/?(\?.*)?$ ]] && endpoint=${BASH_REMATCH[1]}
    prev=$arg
  done

  case "${1:-} ${2:-}" in
    "pr create" | "stack submit" | "stack link")
      # gh-stack takes its target from GH_REPO and the checkout, not from -R.
      [[ "$1" == stack ]] && explicit=""
      target=${explicit:-${GH_REPO:-}}
      if [[ -n "$target" ]]; then
        hit=$(frozen_hit "$target") && refuse_frozen "$hit"
        return 0
      fi
      while read -r _ url _; do
        hit=$(frozen_hit "$url") && refuse_frozen "$hit"
      done < <(git remote -v 2>/dev/null)
      ;;
    api\ *)
      if $graphql; then
        # A mutation's repository id is opaque here, so any createPullRequest
        # is refused while a freeze holds. stdin is buffered to be read, then
        # handed on to the real gh.
        if [[ "$input" == - ]]; then
          stdin_buf=$(cat)
          [[ "$stdin_buf" == *createPullRequest* ]] && refuse_frozen "a GraphQL createPullRequest mutation (${frozen[*]})"
        elif [[ -n "$input" && -r "$input" ]] && grep -q createPullRequest "$input"; then
          refuse_frozen "a GraphQL createPullRequest mutation (${frozen[*]})"
        fi
        [[ "$*" == *createPullRequest* ]] && refuse_frozen "a GraphQL createPullRequest mutation (${frozen[*]})"
      fi
      [[ -n "$endpoint" ]] || return 0
      hit=$(frozen_hit "$endpoint") || return 0
      method=$(printf '%s' "$method" | tr '[:lower:]' '[:upper:]')
      if [[ "$method" == POST ]] || { [[ -z "$method" ]] && $has_fields; }; then
        refuse_frozen "$hit"
      fi
      ;;
  esac
  return 0
}

((${#frozen[@]})) && check_pr_freeze "$@"

# True when the word $1 is the next subcommand in the remaining arguments, with
# STRIPPED holding them without it. It reads one level the way gh's cobra does: a
# bare flag takes the next token as its value unless this level defines it with
# none, which is --help everywhere and $2 here, and an undefined -h counts as
# taking a value. A two-character flag is two bytes, as cobra's len(s) == 2 is.
strip_word() {
  local word=$1 bare=$2 LC_ALL=C arg i
  shift 2
  for ((i = 1; i <= $#; i++)); do
    arg=${!i}
    case $arg in
      --) return 1 ;;
      -*=* | '' | --help | "$bare") ;;
      --* | -?) ((i += 1)) ;;
      -*) ;;
      "$word")
        STRIPPED=("${@:1:i-1}" "${@:i+1}")
        return 0
        ;;
      *) return 1 ;;
    esac
  done
  return 1
}

# True for a `pr merge` command line, with MERGE_ARGS holding its other arguments
# in order. cobra rescans from the first token at each level, with that level's
# flags, so flags may come before either word: `gh -R o/r pr merge 46`,
# `gh pr -R o/r merge 46`, and `gh pr --squash 46 merge` all merge 46, while
# `gh pr --body merge comment 46` is no merge. --version takes no value only at the
# root, so `gh --version pr merge 46` is no merge either.
is_pr_merge() {
  strip_word pr --version "$@" && strip_word merge '' "${STRIPPED[@]}" && MERGE_ARGS=("${STRIPPED[@]}")
}

# True for a `pr checkout` command line or gh's default `co` alias for it, with
# CHECKOUT_ARGS holding its other arguments in order.
is_pr_checkout() {
  if strip_word co --version "$@"; then
    CHECKOUT_ARGS=("${STRIPPED[@]}")
  else
    strip_word pr --version "$@" && strip_word checkout '' "${STRIPPED[@]}" && CHECKOUT_ARGS=("${STRIPPED[@]}")
  fi
}

# Usage: read_pr_args <bare long flags> <long flags with a value> <bare short flags> <short flags with a value> <args...>
# Reads a pull request command's other arguments against its own flags, so a flag's
# value is never taken for the pull request. --help, -h, --repo, and -R are every
# command's. Sets PR_SELECTOR and PR_REPO to what the lookup must carry to resolve the
# PR the command will resolve, and PR_HELP. A token it cannot place, a flag from a later
# gh or a second PR, lands in PR_UNREADABLE.
read_pr_args() {
  local bare_long=" $1 " value_long=" $2 " bare_short=$3 value_short=$4 arg cluster flag value
  shift 4
  PR_SELECTOR=() PR_REPO=() PR_HELP=false PR_UNREADABLE=''
  while (($#)); do
    arg=$1
    shift
    case $arg in
      --)
        PR_SELECTOR+=("$@")
        break
        ;;
      --help) PR_HELP=true ;;
      --repo)
        value=${1-}
        shift
        PR_REPO=(--repo "$value")
        ;;
      --repo=*) PR_REPO=(--repo "${arg#--repo=}") ;;
      --*=*)
        if [[ $value_long != *" ${arg%%=*} "* ]]; then
          PR_UNREADABLE=$arg
          return
        fi
        ;;
      --*)
        if [[ $value_long == *" $arg "* ]]; then
          shift
        elif [[ $bare_long != *" $arg "* ]]; then
          PR_UNREADABLE=$arg
          return
        fi
        ;;
      -?*)
        cluster=${arg#-}
        while [[ -n $cluster ]]; do
          flag=${cluster:0:1}
          cluster=${cluster:1}
          case $flag in
            h) PR_HELP=true ;;
            R | ["$value_short"])
              if [[ -n $cluster ]]; then
                value=${cluster#=}
              else
                value=${1-}
                shift
              fi
              [[ $flag != R ]] || PR_REPO=(--repo "$value")
              cluster=''
              ;;
            ["$bare_short"]) ;;
            *)
              PR_UNREADABLE=$arg
              return
              ;;
          esac
        done
        ;;
      *) PR_SELECTOR+=("$arg") ;;
    esac
  done
  ((${#PR_SELECTOR[@]} <= 1)) || PR_UNREADABLE=${PR_SELECTOR[1]}
}

refuse_call() {
  echo "Blocked: $1" >&2
  echo "$2" >&2
  exit 1
}

# The lookup asks real gh with the merge's own repository and selector, under the
# same GH_REPO, so both resolve one PR. Its stdout alone is the base, because gh
# writes notices to stderr even when it succeeds. Anything but a base that names
# neither main nor master is refused.
if is_pr_merge "$@"; then
  read_pr_args '--admin --auto --delete-branch --disable-auto --merge --rebase --squash' \
    '--subject --body --body-file --author-email --match-head-commit' dmrs AbFt "${MERGE_ARGS[@]}"
  ask_human="Ask the human to perform the merge; the PR body is used as the squash commit message."
  [[ -z $PR_UNREADABLE ]] \
    || refuse_call "cannot read '$PR_UNREADABLE' in this merge, so the guard cannot tell which pull request it names." "$ask_human"
  if ! $PR_HELP; then
    base_branch=$("$real_gh" pr view "${PR_REPO[@]}" --json baseRefName --jq '.baseRefName' -- "${PR_SELECTOR[@]}") \
      && [[ -n $base_branch ]] \
      || refuse_call "cannot determine this pull request's base branch, so it may be merging into main." \
        "Name the PR and its repository (gh pr merge <number> -R <owner>/<repo>), or ask the human to perform the merge."
    if [[ $base_branch == main || $base_branch == master ]]; then
      refuse_call "merging into $base_branch requires human approval." "$ask_human"
    fi
  fi
fi

# Inside an agent slot, Claude's project settings and git's hooks path are live, so
# checking out a head another person owns would run what it tracks. `agent-slot launch
# --pr` makes a slot that runs none of it. Outside a slot this is the operator's own
# checkout, and it looks nothing up. Not knowing the owner refuses, as a wrong owner would.
if is_pr_checkout "$@" && slot_git_dir=$(git rev-parse --absolute-git-dir 2>/dev/null) \
  && [[ -f $slot_git_dir/agent-slot.json ]]; then
  read_pr_args '--detach --force --recurse-submodules' '--branch --worktree' f b "${CHECKOUT_ARGS[@]}"
  slot_repo=${slot_git_dir%/.git}
  slot_repo=${slot_repo%/*}
  slot_repo=${slot_repo##*/}
  make_a_slot="Start a slot that runs nothing from it: agent-slot launch $slot_repo --pr <the pull request>."
  [[ -z $PR_UNREADABLE ]] \
    || refuse_call "cannot read '$PR_UNREADABLE' in this checkout, so the guard cannot tell whose head it is." "$make_a_slot"
  if ! $PR_HELP; then
    make_a_slot="Start a slot that runs nothing from it: agent-slot launch $slot_repo --pr ${PR_SELECTOR[0]:-<the pull request>}."
    # shellcheck source=/dev/null
    source "$(dirname "$(readlink -f "$self")")/../../../../scripts/agent-slot/lib/owners.sh" 2>/dev/null \
      || refuse_call "cannot read the trusted owner list, so the guard cannot tell whose head this is." "$make_a_slot"
    head_owner=$("$real_gh" pr view "${PR_REPO[@]}" --json headRepositoryOwner --jq '.headRepositoryOwner.login' -- "${PR_SELECTOR[@]}") \
      && [[ -n $head_owner ]] \
      || refuse_call "cannot determine who owns this pull request's head, so checking it out here could run another person's code." "$make_a_slot"
    owner_trusted "$head_owner" \
      || refuse_call "this pull request's head belongs to $head_owner, outside the trusted owners, and checking it out here would run what it tracks." "$make_a_slot"
  fi
fi

export GH_MERGE_GUARD_PID=$$
if [[ -n "${stdin_buf+set}" ]]; then
  exec "$real_gh" "$@" <<<"$stdin_buf"
fi
exec "$real_gh" "$@"
