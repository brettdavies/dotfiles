[Unit]
Description=Codex Proxy (corp ChatGPT credits -> openai-compat)
Documentation=https://github.com/icebear0828/codex-proxy
After=default.target

[Service]
Type=oneshot
RemainAfterExit=true
WorkingDirectory=%h/dev/tools/codex-proxy
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=120

[Install]
WantedBy=default.target
