[Unit]
Description=Save the operator's own Rex tabs with rexurrect, once the start-up step has restored them
ConditionHost=bigdaddy

[Service]
Type=oneshot
# A oneshot waits forever by default, and the timer starts no save while one runs.
TimeoutStartSec=2min
Environment=PATH=/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/agent-slot-rex save --output json
