#!/usr/bin/env bash
# sd-commit-doc: commit and push named solutions docs to origin/main, from the
# caller's own worktree of the corpus or, for a caller whose tree is the shared
# clone, by copy-out through a throwaway worktree. `sd-commit-doc --help` has
# the resolution order, the reason codes, and the resume steps.
#
# Rationale:
#   docs/solutions/workflow-issues/shared-working-tree-git-add-commit-race-across-concurrent-agents.md
#   docs/solutions/workflow-issues/unattended-autocommit-on-shared-clone-must-sync-then-rebase.md
set -euo pipefail

# A caller inside a git hook exports these, and they outrank every `git -C`.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY \
  GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX GIT_NAMESPACE

branch=main
SD=${SD_DIR:-$HOME/dev/solutions-docs}

usage() {
  cat <<EOF
usage: sd-commit-doc <msg-file> <path>...
       sd-commit-doc --help

  <msg-file>  commit message file, already authored and /unslop'd
  <path>      a doc relative to the corpus root (workflow-issues/foo.md); name
              both sides of a rename, and a deleted doc by its old path

The tree to publish from, in this order:
  1. SD_TREE, which must be a linked worktree of the corpus
  2. the current directory, when it is inside a linked worktree of the corpus
  3. the current checkout's docs/solutions link: a linked worktree of the
     corpus publishes in place, the shared clone publishes by copy-out, and a
     link anywhere else is refused (tree-unresolved)
  4. no checkout, or a checkout with no docs/solutions link: copy-out

  worktree  stage and commit the named paths in place, rebase onto
            origin/$branch, push, and fast-forward the shared clone
  copy-out  copy the named files from the shared clone into a throwaway
            worktree, commit, push, and reset the shared clone's copies

Environment:
  SD_DIR   the shared clone (default ~/dev/solutions-docs)
  SD_TREE  the worktree to publish from

A failure ends with three lines on stderr:
  sd-commit-doc: reason: <code>
  sd-commit-doc: state: nothing staged | committed in <tree>, not pushed | pushed
  sd-commit-doc: next: <command>

Reason codes:
  usage                 bad arguments, or no message file
  path-invalid          a path that is absolute, a directory, or not in the tree
  tree-unresolved       the tree is neither the shared clone nor a worktree of it
  validation-failed     the corpus validator rejected a doc; nothing staged
  commit-hook-failed    the commit hook rejected the commit; nothing staged
  path-in-shared-clone  the shared clone holds a different copy of a named path
  rebase-in-progress    the worktree is in the middle of a rebase
  overlap-with-origin   origin changed a path the worktree holds uncommitted
  rebase-conflict       a named doc conflicts with origin; the commit is kept
  push-rejected         origin moved again during the retry; the commit is kept
  push-hook-failed      a hook refused the push; the commit is kept
  push-failed           origin is unreachable; the commit is kept
  git-failed            any other git step; git's own error is printed above it

After a rebase conflict:
  git -C <tree> rebase --autostash origin/$branch
  resolve each doc git -C <tree> diff --name-only --diff-filter=U lists
  git -C <tree> add -A -- <each conflicted doc>
  git -C <tree> rebase --continue
  then rerun the same sd-commit-doc
EOF
}

q() { printf '%q' "$1"; }

qlist() {
  local out='' a
  for a; do out+=" $(q "$a")"; done
  printf '%s' "${out# }"
}

step=starting
reason=git-failed
state="nothing staged"
next=
mode=copy-out
tree=$SD
msg=
paths=()
checkout=
throwaway=

rerun_command() {
  local env=
  [[ -z ${SD_DIR:-} ]] || env+="SD_DIR=$(q "$SD_DIR") "
  [[ $mode != worktree ]] || env+="SD_TREE=$(q "$tree") "
  printf '%ssd-commit-doc %s' "$env" "$(qlist "$msg" ${paths[@]+"${paths[@]}"})"
}

# EXIT rather than ERR, because ERR does not fire on an explicit `exit`, which
# is how refuse() leaves. It is also the script's only EXIT handler: bash keeps
# just the most recently installed one, so the throwaway worktree's cleanup
# lives here too. A caller reading the status through a pipe sees the pipe's,
# so these lines on stderr are the signal that survives.
on_exit() {
  local rc=$?
  if [[ -n $throwaway ]]; then
    git -C "$SD" worktree remove --force "$throwaway" 2>/dev/null || true
    git -C "$SD" worktree prune 2>/dev/null || true
  fi
  ((rc != 0)) || return 0
  {
    echo "sd-commit-doc: FAILED during ${step} (exit ${rc})"
    echo "sd-commit-doc: reason: ${reason}"
    echo "sd-commit-doc: state: ${state}"
    echo "sd-commit-doc: next: ${next:-$(rerun_command)}"
  } >&2
  return "$rc"
}
trap on_exit EXIT

# refuse <reason> <next command, empty to rerun> <message line>...
refuse() {
  reason=$1 next=$2
  shift 2
  printf 'sd-commit-doc: %s\n' "$@" >&2
  exit 1
}

validation_failed="frontmatter validation failed; fix the fields above and rerun"
not_forwarded="sd-commit-doc: pushed; $SD not fast-forwarded (it holds a change at a published path, diverged, or is busy); the session-start report and the nightly log name what blocks it"

physical() { (cd "$1" 2>/dev/null && pwd -P); }

# validate_in <root> <newline-separated paths> [changed]
# Runs the root's own copy of the repo's hook library, the code its pre-commit
# runs, so a rejection costs a second here instead of aborting mid-commit.
# `changed` adds every modified tracked doc. No library means no check.
validate_in() {
  local root=$1 files=$2 lib=$1/.githooks/lib-validate.sh
  [[ -r $lib ]] || return 0
  (
    cd "$root" || exit 1
    export SOLUTIONS_DOCS_ROOT=$root
    # shellcheck source=/dev/null
    . "$lib"
    rc=0
    validate_files "$files" || rc=1
    if [[ ${3:-} == changed ]]; then
      validate_changed_since HEAD || rc=1
    fi
    exit "$rc"
  )
}

corpus_worktree() {
  local common top
  common=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  [[ $common == "$sd_common" ]] || return 1
  top=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) || return 1
  top=$(physical "$top") || return 1
  [[ $top != "$sd_top" ]] || return 1
  printf '%s\n' "$top"
}

resolve_tree() {
  local link found
  if [[ -n ${SD_TREE:-} ]]; then
    found=$(corpus_worktree "$SD_TREE") || refuse tree-unresolved "git -C $(q "$SD") worktree list" \
      "SD_TREE=$SD_TREE is not a linked worktree of the corpus at $SD"
  elif found=$(corpus_worktree .); then
    :
  elif [[ -n $checkout && -L $checkout/docs/solutions ]]; then
    link=$(physical "$checkout/docs/solutions") || return 0
    [[ $link != "$sd_top" ]] || return 0
    if ! found=$(corpus_worktree "$link") || [[ $found != "$link" ]]; then
      refuse tree-unresolved "sd-commit-doc --help" \
        "$checkout/docs/solutions resolves to $link," \
        "which is neither the shared clone $SD nor a linked worktree of its corpus;" \
        "nothing was committed or pushed there"
    fi
  else
    return 0
  fi
  mode=worktree tree=$found
}

case ${1:-} in -h | --help)
  usage
  exit 0
  ;;
esac
[[ $# -ge 2 ]] || refuse usage "sd-commit-doc --help" "usage: sd-commit-doc <msg-file> <path>..."
msg=$1
shift
paths=("$@")
[[ -f $msg ]] || refuse usage "sd-commit-doc --help" "message file not found: $msg"
# Every commit runs under `git -C`, which reads a relative path from the tree,
# not from the directory the caller named it in.
[[ $msg == /* ]] || msg="$(cd "$(dirname "$msg")" && pwd)/$(basename "$msg")"
for f in "${paths[@]}"; do
  [[ $f != /* ]] || refuse path-invalid "sd-commit-doc --help" "path must be repo-relative, not absolute: $f"
done

[[ -d $SD/.git ]] || refuse tree-unresolved "sd-commit-doc --help" "not a solutions git repo: $SD"
sd_common=$(git -C "$SD" rev-parse --path-format=absolute --git-common-dir)
sd_top=$(physical "$SD")

step="resolving the tree"
checkout=$(git rev-parse --show-toplevel 2>/dev/null) || checkout=
resolve_tree

head_published() { git -C "$tree" merge-base --is-ancestor HEAD "origin/$branch"; }

rebase_in_progress() {
  local d
  for d in rebase-merge rebase-apply; do
    if [[ -e $(git -C "$tree" rev-parse --path-format=absolute --git-path "$d") ]]; then
      return 0
    fi
  done
  return 1
}

refuse_shared_clone_copy() {
  refuse path-in-shared-clone "diff -u $(q "$tree/$1") $(q "$SD/$1")" \
    "the shared clone holds $SD/$1, and the worktree's copy $tree/$1 is missing or differs;" \
    "that copy can be another session's draft, so nothing was changed in either tree;" \
    "only when it is your own edit, copy it into the worktree and rerun: cp $(q "$SD/$1") $(q "$tree/$1")"
}

# A commit this tree has not pushed yet that touched the path, such as a
# deletion or a rename whose push failed.
unpublished_change() { [[ -n $(git -C "$tree" log -1 --format=%H "origin/$branch..HEAD" -- "$1" 2>/dev/null) ]]; }

check_paths() {
  local f
  for f in "${paths[@]}"; do
    if [[ -d $tree/$f ]]; then
      refuse path-invalid "git -C $(q "$tree") status --short" "a directory, not a doc: $f"
    elif [[ -f $tree/$f || $(git -C "$tree" cat-file -t "HEAD:$f" 2>/dev/null) == blob ]] || unpublished_change "$f"; then
      continue
    elif [[ -n $(git -C "$SD" status --porcelain -- "$f" 2>/dev/null) ]]; then
      refuse_shared_clone_copy "$f"
    else
      refuse path-invalid "git -C $(q "$tree") status --short" "not in $tree and not tracked by its HEAD: $f"
    fi
  done
}

preflight() {
  local existing
  existing=$(for f in "${paths[@]}"; do if [[ -f $tree/$f ]]; then printf '%s\n' "$f"; fi; done)
  validate_in "$tree" "$existing" changed
}

# `git add -A -- <path>` fails on a path in neither the index nor the tree,
# which is what a `git mv` or `git rm` leaves; its change is already staged.
stage_paths() {
  local f present=()
  for f in "${paths[@]}"; do
    if [[ -e $tree/$f ]] || git -C "$tree" ls-files --error-unmatch -- "$f" >/dev/null 2>&1; then
      present+=("$f")
    fi
  done
  ((${#present[@]} == 0)) || git -C "$tree" add -A -- "${present[@]}"
}

commit_paths() {
  step="committing in $tree"
  if ! git -C "$tree" commit --quiet --file "$msg" -- "${paths[@]}"; then
    git -C "$tree" reset -q -- "${paths[@]}"
    refuse commit-hook-failed "" "the commit hook rejected the commit (its output is above); the named paths are unstaged"
  fi
  state="committed in $tree, not pushed"
  git -C "$tree" show --stat HEAD
}

check_shared_clone_copies() {
  local f
  for f in "${paths[@]}"; do
    [[ -f $SD/$f && -n $(git -C "$SD" status --porcelain -- "$f") ]] || continue
    [[ -f $tree/$f ]] && cmp -s "$SD/$f" "$tree/$f" && continue
    refuse_shared_clone_copy "$f"
  done
}

# Refuses when the rebase's autostash could conflict on re-apply, which would
# leave the stash in the corpus's shared refs/stash.
refuse_overlap() {
  local dirty theirs overlap line lines=() names=()
  dirty=$({
    git -C "$tree" diff --name-only --no-renames HEAD
    git -C "$tree" diff --name-only --no-renames --cached
    git -C "$tree" ls-files --others --exclude-standard
  } | LC_ALL=C sort -u)
  theirs=$(git -C "$tree" diff --name-only --no-renames "HEAD...origin/$branch" | LC_ALL=C sort -u)
  overlap=$(LC_ALL=C comm -12 <(printf '%s\n' "$dirty") <(printf '%s\n' "$theirs"))
  [[ -n $overlap ]] || return 0
  while IFS= read -r line; do
    lines+=("  $line")
    names+=("$line")
  done <<<"$overlap"
  refuse overlap-with-origin "git -C $(q "$tree") diff HEAD...origin/$branch -- $(qlist "${names[@]}")" \
    "origin/$branch changed these paths, and $tree holds uncommitted changes to them:" "${lines[@]}" \
    "publish them with their own sd-commit-doc call, or move them aside, then rerun; the commit stays in $tree"
}

sync_with_origin() {
  step="fetching origin/$branch"
  git -C "$tree" fetch --quiet origin "$branch" \
    || refuse push-failed "" "could not fetch origin/$branch (git's error is above); the commit stays in $tree"
  if git -C "$tree" merge-base --is-ancestor "origin/$branch" HEAD; then
    return 0
  fi
  step="checking for overlap with origin/$branch"
  refuse_overlap
  step="rebasing onto origin/$branch"
  git -C "$tree" rebase --quiet --autostash "origin/$branch" && return 0
  rebase_in_progress || refuse git-failed "" "the rebase onto origin/$branch failed (git's error is above)"
  git -C "$tree" rebase --abort
  local t
  t=$(q "$tree")
  refuse rebase-conflict "git -C $t rebase --autostash origin/$branch" \
    "a named doc conflicts with origin/$branch; the rebase was aborted and the commit stays in $tree" \
    "resume with:" \
    "  git -C $t rebase --autostash origin/$branch" \
    "  resolve each conflicted doc that git -C $t diff --name-only --diff-filter=U lists," \
    "  then: git -C $t add -A -- <each conflicted doc>" \
    "  git -C $t rebase --continue" \
    "  then rerun: $(rerun_command)"
}

push_output=
push_head() { push_output=$(git -C "$tree" push --quiet origin "HEAD:$branch" 2>&1); }

# origin moving between the push's negotiation and its ref update is the same
# race as a non-fast-forward, reported as a remote rejection.
push_rejected_non_ff() {
  [[ $push_output == *"[rejected]"*"(fetch first)"* || $push_output == *"[rejected]"*"(non-fast-forward)"* ||
    $push_output == *"[remote rejected]"*"(incorrect old value provided)"* ||
    $push_output == *"[remote rejected]"*"(cannot lock ref"* || $push_output == *"[remote rejected]"*"(failed to update ref)"* ]]
}

refuse_push() {
  printf '%s\n' "$push_output" >&2
  if push_rejected_non_ff; then
    refuse push-rejected "" "origin/$branch moved again after one rebase and retry; the commit stays in $tree"
  elif grep -q '^fatal:' <<<"$push_output"; then
    refuse push-failed "" "the push could not reach origin (git's error is above); the commit stays in $tree"
  fi
  refuse push-hook-failed "" "the push was refused (the hook's output is above); the commit stays in $tree"
}

publish_in_place() {
  step="checking $tree"
  head_published || state="committed in $tree, not pushed"
  ! rebase_in_progress || refuse rebase-in-progress "git -C $(q "$tree") rebase --continue" \
    "$tree is in the middle of a rebase; finish it with git -C $(q "$tree") rebase --continue" \
    "or drop it with git -C $(q "$tree") rebase --abort, then rerun"
  check_paths

  step="validating the docs"
  preflight || refuse validation-failed "" "$validation_failed"

  step="staging in $tree"
  stage_paths
  if ! git -C "$tree" diff --cached --quiet HEAD -- "${paths[@]}"; then
    commit_paths
  elif head_published; then
    check_shared_clone_copies
    echo "sd-commit-doc: nothing to publish; ${paths[*]} already on origin/$branch ($tree)"
    exit 0
  fi

  sync_with_origin
  step="pushing to origin/$branch"
  if ! push_head; then
    push_rejected_non_ff || refuse_push
    sync_with_origin
    step="pushing to origin/$branch (retry)"
    push_head || refuse_push
  fi
  state=pushed

  # Never revert or clean here: a file at a published path in the shared
  # clone can be a prime session's draft.
  step="fast-forwarding the shared clone"
  git -C "$SD" merge --ff-only --quiet "origin/$branch" 2>/dev/null || echo "$not_forwarded" >&2
  echo "sd-commit-doc: committed and pushed ${#paths[@]} file(s) from $tree (worktree)"
}

if [[ $mode == worktree ]]; then
  publish_in_place
  exit 0
fi

step="checking the named files"
for f in "${paths[@]}"; do
  [[ -f $SD/$f ]] || refuse path-invalid "git -C $(q "$SD") worktree list" \
    "file not found under $SD: $f" \
    "the tree is the shared clone (copy-out), resolved from ${checkout:-no checkout};" \
    "a doc drafted in a worktree publishes with SD_TREE=<worktree>, or from the checkout whose docs/solutions links to it"
done

step="frontmatter pre-flight"
validate_in "$SD" "$(printf '%s\n' "${paths[@]}")" \
  || refuse validation-failed "" "$validation_failed"

step="fetching origin/$branch"
git -C "$SD" fetch --quiet origin "$branch"

step="preparing the isolated worktree"
throwaway=$(mktemp -d)/sd-wt
git -C "$SD" worktree add --quiet --detach "$throwaway" "origin/$branch"

for f in "${paths[@]}"; do
  mkdir -p "$throwaway/$(dirname "$f")"
  cp "$SD/$f" "$throwaway/$f"
  git -C "$throwaway" add -- "$f"
done

step="committing in the isolated worktree"
git -C "$throwaway" commit --quiet --file "$msg"
git -C "$throwaway" show --stat HEAD

step="pushing to origin/$branch"
if ! git -C "$throwaway" push --quiet origin "HEAD:$branch" 2>/dev/null; then
  git -C "$SD" fetch --quiet origin "$branch"
  git -C "$throwaway" rebase "origin/$branch"
  git -C "$throwaway" push --quiet origin "HEAD:$branch"
fi
state=pushed
next="git -C $(q "$SD") status --short"

git -C "$SD" worktree remove --force "$throwaway" 2>/dev/null || true
git -C "$SD" worktree prune 2>/dev/null || true
throwaway=

# The files just committed still sit in the shared clone as untracked or
# modified copies and would block a fast-forward; their content is on origin
# now, so discard those copies first.
step="fast-forwarding the shared clone"
git -C "$SD" fetch --quiet origin "$branch"
if ! git -C "$SD" merge --ff-only --quiet "origin/$branch" 2>/dev/null; then
  # `git checkout -- <paths>` refuses every path when any one is unknown to the
  # shared index, so new files go to `git clean` instead.
  step="reverting the shared clone's copies (the push already landed)"
  tracked=() untracked=()
  for f in "${paths[@]}"; do
    if git -C "$SD" ls-files --error-unmatch -- "$f" >/dev/null 2>&1; then
      tracked+=("$f")
    else
      untracked+=("$f")
    fi
  done
  ((${#tracked[@]} == 0)) || git -C "$SD" checkout -q -- "${tracked[@]}"
  ((${#untracked[@]} == 0)) || git -C "$SD" clean -fq -- "${untracked[@]}"
  step="fast-forwarding the shared clone"
  git -C "$SD" merge --ff-only --quiet "origin/$branch" 2>/dev/null || echo "$not_forwarded" >&2
fi

echo "sd-commit-doc: committed and pushed ${#paths[@]} file(s) from $SD (copy-out)"
