[Unit]
Description=Sync starred GitHub repos and their clones
ConditionHost=bigdaddy
OnSuccess=github-stars-pdf.service

[Service]
Type=oneshot
Environment=PATH=/home/linuxbrew/.linuxbrew/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/github-stars/env
ExecStart=%h/.local/bin/github-stars -j 8

# Hardening. No PrivateTmp= or other namespace setting: in a user unit it maps root to nobody, and ssh, which git runs
# here whenever no gh token is available, then rejects every root-owned file /etc/ssh/ssh_config includes
# (tests/user-unit-sandboxing.bats).
NoNewPrivileges=true
